<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:PubGames.Services"
             x:Class="PubGames.App">
	<Application.Resources>
		<ResourceDictionary>

			<services:InvertedBoolConverter x:Key="InvertedBoolConverter" />

			<Color x:Key="Primary">#3C3489</Color>
			<Color x:Key="PrimaryDark">#26215C</Color>
			<Color x:Key="Accent">#0F6E56</Color>
			<Color x:Key="Danger">#A32D2D</Color>
			<Color x:Key="Warning">#854F0B</Color>
			<Color x:Key="SurfaceLight">#FFFFFF</Color>
			<Color x:Key="SurfaceMuted">#F1EFE8</Color>
			<Color x:Key="TextPrimary">#2C2C2A</Color>
			<Color x:Key="TextSecondary">#5F5E5A</Color>
			<Color x:Key="Border">#D3D1C7</Color>

			<Style TargetType="Label">
				<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
			</Style>

			<Style TargetType="Button">
				<Setter Property="TextColor" Value="White" />
				<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
				<Setter Property="CornerRadius" Value="8" />
				<Setter Property="Padding" Value="16,10" />
			</Style>

			<Style TargetType="Entry">
				<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
				<Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
			</Style>

		</ResourceDictionary>
	</Application.Resources>
</Application>
