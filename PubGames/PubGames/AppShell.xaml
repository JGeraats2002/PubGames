<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PubGames.Views"
       x:Class="PubGames.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Pub Games">

	<!-- Only shown once signed in (App swaps between LoginPage and this shell).
	     Players is the start of a game night: players → choose game → rules → scoreboard,
	     all pushed onto this tab's stack (see routes in AppShell.xaml.cs). -->
	<TabBar>
		<ShellContent Title="Players"
		              ContentTemplate="{DataTemplate views:PlayerEntryPage}"
		              Route="players" />

		<!-- Hidden for regular players; visible to admins and moderators (Team: admins only). -->
		<Tab x:Name="AdminTab" Title="Admin" Route="admin">
			<ShellContent Title="Library"
			              ContentTemplate="{DataTemplate views:AdminLibraryPage}"
			              Route="library" />
			<ShellContent x:Name="TeamContent" Title="Team"
			              ContentTemplate="{DataTemplate views:AdminTeamPage}"
			              Route="team" />
		</Tab>

		<ShellContent Title="Account"
		              ContentTemplate="{DataTemplate views:AccountPage}"
		              Route="account" />
	</TabBar>

</Shell>
