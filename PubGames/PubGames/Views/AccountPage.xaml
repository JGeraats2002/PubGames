<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="Account">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="8">

			<Label Text="{Binding DisplayName}" FontSize="20" />
			<Label Text="{Binding Email}" TextColor="{StaticResource TextSecondary}" FontSize="13" />

			<Border IsVisible="{Binding IsTeamMember}" BackgroundColor="{StaticResource Accent}"
			        StrokeThickness="0" Padding="10,4" HorizontalOptions="Start" Margin="0,4,0,0">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="6" />
				</Border.StrokeShape>
				<Label Text="{Binding RoleName}" TextColor="White" FontSize="12" />
			</Border>
			<Label IsVisible="{Binding IsTeamMember}" FontSize="12" TextColor="{StaticResource TextSecondary}"
			       Text="{Binding RoleDescription}" />

			<Button Text="Sign out" Command="{Binding SignOutCommand}" Margin="0,16,0,0"
			        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
