<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:loc="clr-namespace:PubGames.Services"
             x:Class="PubGames.Views.AccountPage"
             x:DataType="vm:AccountViewModel"
             Title="{loc:T Account_Settings}">

	<!-- The Account tab's main page: one row per heading, each opening its own page. -->
	<ContentPage.Resources>
		<Style x:Key="SettingsRow" TargetType="Border">
			<Setter Property="Stroke" Value="{StaticResource Border}" />
			<Setter Property="Padding" Value="14,12" />
			<Setter Property="StrokeShape" Value="RoundRectangle 10" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="10">

			<!-- Profile: picture, name and player code. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnProfileTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
					<Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceMuted}"
					        StrokeShape="RoundRectangle 28">
						<Grid>
							<Label Text="{Binding Initials}" FontSize="20" IsVisible="{Binding HasNoPhoto}"
							       HorizontalOptions="Center" VerticalOptions="Center" />
							<Image Source="{Binding PhotoRef, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill"
							       IsVisible="{Binding HasPhoto}" />
						</Grid>
					</Border>
					<VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
						<Label Text="{loc:T Account_Profile}" FontSize="18" FontAttributes="Bold" />
						<Label Text="{Binding ProfileName}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
						<Label Text="{Binding Code, StringFormat={loc:T Account_PlayerCode0}}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
					</VerticalStackLayout>
					<Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- Stats over every finished game you played in. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnStatsTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<VerticalStackLayout Spacing="2">
						<Label Text="{loc:T Account_MyStats}" FontSize="18" FontAttributes="Bold" />
						<Label Text="{Binding Totals.Summary}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
						<Label Text="{Binding StatsMessage}" FontSize="12" TextColor="{StaticResource TextSecondary}"
						       IsVisible="{Binding HasStatsMessage}" />
					</VerticalStackLayout>
					<Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- The Pub Games Pass, and restoring purchases. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnPassTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<Label Text="{loc:T Account_PubGamesPass}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
					<Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- The app's language: its flag and name. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnLanguageTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
					<Border WidthRequest="32" HeightRequest="32" StrokeThickness="1" Stroke="{StaticResource Border}"
					        StrokeShape="Ellipse" VerticalOptions="Center">
						<Image Source="{Binding LanguageFlag}" Aspect="AspectFill" />
					</Border>
					<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
						<Label Text="{loc:T Account_Language}" FontSize="18" FontAttributes="Bold" />
						<Label Text="{Binding LanguageName}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
					</VerticalStackLayout>
					<Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- Players you blocked. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnBlockedTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<VerticalStackLayout Spacing="2">
						<Label Text="{loc:T Account_BlockedPlayers}" FontSize="18" FontAttributes="Bold" />
					</VerticalStackLayout>
					<Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- Feedback to the admins. -->
			<Border Style="{StaticResource SettingsRow}">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnFeedbackTapped" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<VerticalStackLayout Spacing="2">
						<Label Text="{loc:T Account_Feedback}" FontSize="18" FontAttributes="Bold" />
					</VerticalStackLayout>
					<Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
				</Grid>
			</Border>

			<!-- Signing out, on its own. -->
			<Button Text="{loc:T Account_SignOut}" Clicked="OnSignOutClicked" Margin="0,16,0,0"
			        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />

			<!-- Deleting the account and its data for good (required by Google Play for apps with accounts). -->
			<Button Text="{loc:T Account_DeleteAccount}" Clicked="OnDeleteAccountClicked"
			        BackgroundColor="Transparent" TextColor="{StaticResource Danger}" BorderWidth="0" FontSize="13" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
