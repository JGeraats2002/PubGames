<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:views="clr-namespace:PubGames.Views"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.AdminCreateGamePage"
             x:DataType="vm:AdminCreateGameViewModel"
             Title="{Binding PageTitle}">

	<ContentPage.Resources>
		<!-- The tabs at the top: the open page filled, the others outlined. -->
		<Style x:Key="TabButton" TargetType="Button">
			<Setter Property="BackgroundColor" Value="Transparent" />
			<Setter Property="TextColor" Value="{StaticResource Primary}" />
			<Setter Property="BorderColor" Value="{StaticResource Border}" />
			<Setter Property="BorderWidth" Value="1" />
			<Setter Property="Padding" Value="2,0" />
			<Setter Property="HeightRequest" Value="48" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="LineBreakMode" Value="TailTruncation" />
		</Style>

		<!-- Section titles, with a ✕ to take the part off the form again. -->
		<Style x:Key="SectionTitle" TargetType="Label">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
			<Setter Property="VerticalOptions" Value="Center" />
			<Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
		</Style>
		<Style x:Key="RemoveSectionButton" TargetType="Button">
			<Setter Property="Text" Value="✕" />
			<Setter Property="BackgroundColor" Value="Transparent" />
			<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
			<Setter Property="BorderWidth" Value="0" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="HeightRequest" Value="48" />
			<Setter Property="MinimumWidthRequest" Value="48" />
			<Setter Property="SemanticProperties.Description" Value="{loc:T AdminCreateGame_RemoveThisPart}" />
			<Setter Property="FontSize" Value="14" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,*,Auto">

	<!-- General, Scoring, Rules. Players see none of this: they see the game as before. -->
	<Grid Padding="20,12,20,8" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
		<Button Text="{loc:T AdminCreateGame_General}" Style="{StaticResource TabButton}" Clicked="OnGeneralTabClicked">
			<Button.Triggers>
				<DataTrigger TargetType="Button" Binding="{Binding IsGeneralPage}" Value="True">
					<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
					<Setter Property="TextColor" Value="White" />
				</DataTrigger>
			</Button.Triggers>
		</Button>
		<Button Grid.Column="1" Text="{loc:T AdminCreateGame_Scoring}" Style="{StaticResource TabButton}" Clicked="OnScoringTabClicked">
			<Button.Triggers>
				<DataTrigger TargetType="Button" Binding="{Binding IsScoringPage}" Value="True">
					<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
					<Setter Property="TextColor" Value="White" />
				</DataTrigger>
			</Button.Triggers>
		</Button>
		<Button Grid.Column="2" Text="{loc:T AdminCreateGame_Rules}" Style="{StaticResource TabButton}" Clicked="OnRulesTabClicked">
			<Button.Triggers>
				<DataTrigger TargetType="Button" Binding="{Binding IsRulesPage}" Value="True">
					<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
					<Setter Property="TextColor" Value="White" />
				</DataTrigger>
			</Button.Triggers>
		</Button>
		<Button Grid.Column="3" Text="{loc:T AdminCreateGame_Languages}" Style="{StaticResource TabButton}" Clicked="OnLanguagesTabClicked">
			<Button.Triggers>
				<DataTrigger TargetType="Button" Binding="{Binding IsLanguagesPage}" Value="True">
					<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
					<Setter Property="TextColor" Value="White" />
				</DataTrigger>
			</Button.Triggers>
		</Button>
	</Grid>

	<BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="End" />

	<ScrollView x:Name="FormScroll" Grid.Row="1">
		<VerticalStackLayout Padding="20,8,20,20" Spacing="14">

			<!-- Moderators: what happens with their submission, or why it was rejected. -->
			<Border IsVisible="{Binding HasReviewInfo}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<Label Text="{Binding ReviewInfo}" FontSize="13" />
			</Border>

			<!-- ===== Page 1: general info ===== -->
			<VerticalStackLayout Spacing="14" IsVisible="{Binding IsGeneralPage}">

				<Label Text="{loc:T AdminCreateGame_GameName}" Style="{StaticResource SectionTitle}" />
				<Entry Placeholder="{loc:T AdminCreateGame_EGKingsCup}" Text="{Binding Name}" />

				<!-- The language the name and rules are written in; the other languages are translated from it. -->
				<Label Text="{loc:T AdminCreateGame_WrittenIn}" Style="{StaticResource SectionTitle}" />
				<Picker Title="{loc:T AdminCreateGame_ChooseTheLanguage}" ItemsSource="{Binding Languages}" ItemDisplayBinding="{Binding Name}"
				        SelectedItem="{Binding SourceLanguage}" />

				<VerticalStackLayout Spacing="14">
					<Label Text="{loc:T AdminCreateGame_CoverImage}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
					<!-- Square and as wide as the page, on every phone; the same part of the picture as the icon in the game lists. -->
					<Border IsVisible="{Binding HasCover}" StrokeThickness="0" HorizontalOptions="Fill" HeightRequest="{Binding Width, Source={RelativeSource Self}, x:DataType=Border}">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<Image Source="{Binding CoverImageUrl, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
					</Border>
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<Button Text="{Binding CoverButtonText}" Clicked="OnCoverClicked"
						        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"
						        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
						        BorderColor="{StaticResource Border}" BorderWidth="1" />
						<Button Grid.Column="1" Text="{loc:T AdminCreateGame_Remove}" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}"
						        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
						        BorderColor="{StaticResource Border}" BorderWidth="1" />
					</Grid>
				</VerticalStackLayout>

				<VerticalStackLayout Spacing="14">
					<Label Text="{loc:T AdminCreateGame_Pricing}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
					<Picker Title="{loc:T AdminCreateGame_ChooseThePrice}" ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding SelectedPriceOption}" />
				</VerticalStackLayout>

				<!-- Each limit has its own switch. Both off: any number of players. Players filter games by this. -->
				<VerticalStackLayout Spacing="14">
					<Label Text="{loc:T AdminCreateGame_NumberOfPlayers}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
					<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<VerticalStackLayout Spacing="10">
							<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
								<Label Text="{loc:T AdminCreateGame_MinimumPlayers}" VerticalOptions="Center" />
								<Switch Grid.Column="1" IsToggled="{Binding HasMinPlayers}" VerticalOptions="Center" />
								<Entry Grid.Column="2" Text="{Binding MinPlayers}" Keyboard="Numeric" Placeholder="e.g. 2"
								       HorizontalTextAlignment="End" IsVisible="{Binding HasMinPlayers}" />
							</Grid>
							<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
								<Label Text="{loc:T AdminCreateGame_MaximumPlayers}" VerticalOptions="Center" />
								<Switch Grid.Column="1" IsToggled="{Binding HasMaxPlayers}" VerticalOptions="Center" />
								<Entry Grid.Column="2" Text="{Binding MaxPlayers}" Keyboard="Numeric" Placeholder="e.g. 6"
								       HorizontalTextAlignment="End" IsVisible="{Binding HasMaxPlayers}" />
							</Grid>
							<Label Text="{Binding PlayersPreview}" FontSize="12" FontAttributes="Bold" />
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!-- Tap to select; at least one per main category. Players filter games by these. -->
				<VerticalStackLayout Spacing="14">
					<Label Text="{loc:T AdminCreateGame_Categories}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
					<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CategoryChoiceGroups}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:CategoryChoiceGroup">
								<VerticalStackLayout Spacing="6">
									<Label Text="{Binding Title}" FontAttributes="Bold" />
									<views:CategoryClouds ItemsSource="{Binding Choices}" Placeholder="{loc:T AdminCreateGame_ChooseOneOrMore}" CategoryTapped="OnCategoryTapped" />
								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</VerticalStackLayout>

			<!-- ===== Page 2: scoring ===== -->
			<VerticalStackLayout Spacing="14" IsVisible="{Binding IsScoringPage}">

				<!-- Only the scoring type is always there (a game needs one); this adds the other parts. They always show in the same order. -->
				<Button Text="{loc:T AdminCreateGame_AddYourRules}" Clicked="OnAddSectionClicked" IsVisible="{Binding CanAddSection}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Primary}" BorderWidth="1" />

				<VerticalStackLayout Spacing="14">
					<Label Text="{loc:T AdminCreateGame_ScoringType}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0" />
					<views:ScoringEditorView BindingContext="{Binding Scoring}" />
				</VerticalStackLayout>


				<!-- Everything about a subgame: how its result is noted, who starts, the input order and how it ends.
				     How many subgames to play, the players choose when they start. -->
				<VerticalStackLayout Spacing="14" IsVisible="{Binding SubgameAdded}">
					<Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
						<Label Text="{loc:T AdminCreateGame_Subgame}" Style="{StaticResource SectionTitle}" />
						<Button Grid.Column="1" Style="{StaticResource RemoveSectionButton}" Clicked="OnRemoveSectionClicked"
						        CommandParameter="{x:Static vm:GameFormSection.Subgame}" />
					</Grid>
					<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<VerticalStackLayout Spacing="10">
							<Label Text="{loc:T AdminCreateGame_ResultOfEachSubgame}" />
							<Picker Title="{loc:T AdminCreateGame_ChooseResultOfEachSubgame}" ItemsSource="{Binding ResultModeOptions}" SelectedItem="{Binding SelectedResultModeOption}" />
							<Label Text="{Binding ScoreDirectionTitle}" />
							<Picker Title="{Binding ScoreDirectionPrompt}" ItemsSource="{Binding BestScoreOptions}" SelectedIndex="{Binding BestScoreIndex}" />

							<Label Text="{loc:T AdminCreateGame_WhoStartsTheNextSubgame}" />
							<Picker Title="{loc:T AdminCreateGame_ChooseWhoStarts}" ItemsSource="{Binding StartRotationOptions}" SelectedItem="{Binding SelectedStartRotation}" />

							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
								<CheckBox IsChecked="{Binding FixedTurnOrder}" VerticalOptions="Center" />
								<Label Grid.Column="1" Text="{loc:T AdminCreateGame_FixedInputOrder}"
								       VerticalOptions="Center" />
							</Grid>

							<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
								<Label Text="{loc:T AdminCreateGame_ASubgameEndsAtScore}" VerticalOptions="Center" />
								<Switch Grid.Column="1" IsToggled="{Binding HasEndScore}" VerticalOptions="Center" />
								<Entry Grid.Column="2" Text="{Binding EndScore}" Keyboard="Telephone" Placeholder="e.g. 100"
								       HorizontalTextAlignment="End" IsVisible="{Binding HasEndScore}" />
							</Grid>
							<VerticalStackLayout Spacing="10" IsVisible="{Binding HasEndScore}">
								<Label Text="{loc:T AdminCreateGame_HowTheSubgameEnds}" />
								<Picker Title="{loc:T AdminCreateGame_ChooseHowItEnds}" ItemsSource="{Binding EndModeOptions}" SelectedItem="{Binding SelectedEndMode}" />
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding CanHaveEqualizingTurn}">
									<CheckBox IsChecked="{Binding EqualizingTurn}" VerticalOptions="Center" />
									<Label Grid.Column="1" Text="{loc:T AdminCreateGame_EqualizingTurn}"
									       VerticalOptions="Center" />
								</Grid>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!-- Allowed: tied players share the result. Not allowed: they play a duel with its own rules. -->
				<VerticalStackLayout Spacing="14" IsVisible="{Binding TiesAdded}">
					<Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
						<Label Text="{loc:T AdminCreateGame_Ties}" Style="{StaticResource SectionTitle}" />
						<Button Grid.Column="1" Style="{StaticResource RemoveSectionButton}" Clicked="OnRemoveSectionClicked"
						        CommandParameter="{x:Static vm:GameFormSection.Ties}" />
					</Grid>
					<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<VerticalStackLayout Spacing="10">
							<HorizontalStackLayout Spacing="8">
								<CheckBox IsChecked="{Binding AllowTies}" />
								<Label Text="{loc:T AdminCreateGame_TiesAreAllowed}" VerticalOptions="Center" />
							</HorizontalStackLayout>

							<VerticalStackLayout Spacing="10" IsVisible="{Binding HasNoTies}">
								<Label Text="{loc:T AdminCreateGame_WhenIsATiePlayed}" />
								<Picker Title="{loc:T AdminCreateGame_ChooseWhen}" ItemsSource="{Binding TieBreakMomentOptions}" SelectedItem="{Binding SelectedTieBreakMoment}" />
								<Label Text="{loc:T AdminCreateGame_WhichTiesArePlayedOff}" />
								<Picker Title="{loc:T AdminCreateGame_ChooseWhichTies}" ItemsSource="{Binding TieBreakScopeOptions}" SelectedItem="{Binding SelectedTieBreakScope}" />
							</VerticalStackLayout>

							<!-- The duel's rules, filled in like the game's (or copied from them and changed). -->
							<VerticalStackLayout Spacing="10" IsVisible="{Binding HasNoTies}">
								<Label Text="{loc:T AdminCreateGame_TheDuelSRules}" FontAttributes="Bold" Margin="0,6,0,0" />
								<Button Text="{loc:T AdminCreateGame_CopyTheGameSRules}" Clicked="OnCopyGameRulesClicked"
								        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
								        BorderColor="{StaticResource Primary}" BorderWidth="1" />

								<Label Text="{loc:T AdminCreateGame_DuelScoringType}" />
								<views:ScoringEditorView BindingContext="{Binding DuelScoring}" />

								<Label Text="{loc:T AdminCreateGame_WhoWinsTheDuel}" />
								<Picker Title="{loc:T AdminCreateGame_ChooseWhoWinsTheDuel}" ItemsSource="{Binding DuelBestScoreOptions}" SelectedIndex="{Binding DuelBestScoreIndex}" />

								<Label Text="{loc:T AdminCreateGame_HowTheDuelEnds}" />
								<Picker Title="{loc:T AdminCreateGame_ChooseHowTheDuelEnds}" ItemsSource="{Binding DuelEndOptions}" SelectedItem="{Binding SelectedDuelEnd}" />

								<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsDuelTurns}">
									<Label Text="{loc:T AdminCreateGame_TurnsEach}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Text="{Binding DuelTurns}" Keyboard="Numeric" HorizontalTextAlignment="End" />
								</Grid>
								<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsDuelScore}">
									<Label Text="{loc:T AdminCreateGame_TheDuelGoesTo}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Text="{Binding DuelEndScore}" Keyboard="Telephone" Placeholder="e.g. 10" HorizontalTextAlignment="End" />
								</Grid>
								<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsDuelBestOf}">
									<Label Text="{loc:T AdminCreateGame_BestOfRounds}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Text="{Binding DuelRounds}" Keyboard="Numeric" HorizontalTextAlignment="End" />
								</Grid>
								<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12" IsVisible="{Binding CanHaveDuelMargin}">
									<Label Text="{loc:T AdminCreateGame_WinByAtLeast}" VerticalOptions="Center" />
									<Switch Grid.Column="1" IsToggled="{Binding DuelHasMargin}" VerticalOptions="Center" />
									<Entry Grid.Column="2" Text="{Binding DuelMargin}" Keyboard="Numeric" HorizontalTextAlignment="End"
									       IsVisible="{Binding DuelHasMargin}" />
								</Grid>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<!-- ===== Page 3: the written rules =====
			     Pieces of text and pictures follow each other without anything in between, inside one box, so it
			     reads and types as one text. Hold a picture to edit, move or remove it. -->
			<VerticalStackLayout Spacing="14" IsVisible="{Binding IsRulesPage}">
				<Label Text="{loc:T AdminCreateGame_HowToPlay}" Style="{StaticResource SectionTitle}" />
				<Border Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,10" MinimumHeightRequest="140">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="8" />
					</Border.StrokeShape>
					<VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding RulesBlocks}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:EditableRulesBlock">
								<Grid>
									<views:PlainEditor Text="{Binding Text}" IsVisible="{Binding IsText}" Placeholder="{Binding Placeholder}"
									                   AutoSize="TextChanges" Focused="OnRulesEditorFocused" />
									<!-- The margin is the empty line above and below every picture. -->
									<views:RulesImage ImageRef="{Binding ImageRef}" IsVisible="{Binding IsImage}" Margin="0,14">
										<views:RulesImage.Behaviors>
											<views:TapAndHoldBehavior Held="OnRulesImageHeld" />
										</views:RulesImage.Behaviors>
									</views:RulesImage>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</Border>
				<Button Text="{loc:T AdminCreateGame_AddPictureAtTheCursor}" Clicked="OnInsertRulesImageClicked"
				        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
			</VerticalStackLayout>

			<!-- ===== Page 4: translations =====
			     The cloud translates the original sentence by sentence; here a person checks each language and
			     changes, adds or removes what isn't right. The text itself isn't typed in freely. -->
			<VerticalStackLayout Spacing="14" IsVisible="{Binding IsLanguagesPage}">
				<Label Text="{Binding WrittenInMyLanguageHint}" IsVisible="{Binding WrittenInMyLanguage}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
				<Label Text="{Binding ToCheckOverview}" FontSize="13" FontAttributes="Bold" />

				<!-- Sentences that came into the original from a translation: for someone who speaks the original's language. -->
				<Border IsVisible="{Binding HasAddedToOriginal}" BackgroundColor="{StaticResource ScoreWarningTint}" StrokeThickness="0" Padding="12,10">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="8" />
					</Border.StrokeShape>
					<VerticalStackLayout Spacing="10">
						<Label Text="{loc:T AdminCreateGame_NewInTheOriginal}" FontSize="13" FontAttributes="Bold" />
						<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding AddedToOriginal}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:AddedToOriginal">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<VerticalStackLayout Spacing="2">
											<Label Text="{Binding Sentence}" FontSize="14" />
											<Label FontSize="12" TextColor="{StaticResource TextSecondary}">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="{Binding LanguageName}" />
														<Span Text=": " />
														<Span Text="{Binding AddedAs}" />
													</FormattedString>
												</Label.FormattedText>
											</Label>
										</VerticalStackLayout>
										<Button Grid.Column="1" Text="{loc:T AdminCreateGame_Approve}" HeightRequest="48" VerticalOptions="Center"
										        Command="{Binding ApproveAddedToOriginalCommand, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}"
										        CommandParameter="{Binding .}" />
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>

				<Picker Title="{loc:T AdminCreateGame_ChooseALanguage}" ItemsSource="{Binding TranslationLanguages}" ItemDisplayBinding="{Binding Name}"
				        SelectedItem="{Binding TranslationLanguage}" />
				<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12,10">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="8" />
					</Border.StrokeShape>
					<VerticalStackLayout Spacing="6">
						<Label Text="{Binding TranslationStatus}" FontSize="13" />
						<Label Text="{Binding CheckStatus}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Warning}">
							<Label.Triggers>
								<DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
									<Setter Property="TextColor" Value="{StaticResource Accent}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</VerticalStackLayout>
				</Border>

				<Label Text="{loc:T AdminCreateGame_GameName}" Style="{StaticResource SectionTitle}" />
				<Entry Text="{Binding TranslatedName}" />

				<!-- Text on the cover picture, when it was made with Create image: the cover with the texts in this language. -->
				<VerticalStackLayout Spacing="8" IsVisible="{Binding HasCoverTexts}">
					<Label Text="{loc:T AdminCreateGame_TextOnTheCover}" Style="{StaticResource SectionTitle}" />
					<views:RulesImage ImageRef="{Binding CoverPreviewRef}" HorizontalOptions="Center" WidthRequest="200" />
					<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CoverTexts}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="vm:PictureText">
								<VerticalStackLayout Spacing="2">
									<Label Text="{Binding Original}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
									<Entry Text="{Binding Text}" />
								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>

				<!-- What to do with the translation: check it, or add, change or remove sentences. -->
				<VerticalStackLayout Spacing="8" IsVisible="{Binding HasSentences}">
					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding IsBrowsing}">
						<Button Text="{loc:T AdminCreateGame_Add}" Command="{Binding StartAddingCommand}" HeightRequest="48"
						        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
						<Button Grid.Column="1" Text="{loc:T AdminCreateGame_Change}" Command="{Binding StartChangingCommand}" HeightRequest="48"
						        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
						<Button Grid.Column="2" Text="{loc:T AdminCreateGame_Remove}" Command="{Binding StartRemovingCommand}" HeightRequest="48"
						        BackgroundColor="Transparent" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" BorderWidth="1" />
					</Grid>
					<Button Text="{loc:T AdminCreateGame_TranslationIsFine}" Command="{Binding ApproveTranslationCommand}"
					        IsVisible="{Binding CanApproveTranslation}" />

					<!-- Adding: tap the sentence to add after, or add at the start. -->
					<VerticalStackLayout Spacing="8" IsVisible="{Binding IsAdding}">
						<Label Text="{loc:T AdminCreateGame_TapWhereToAdd}" FontSize="13" TextColor="{StaticResource Warning}" />
						<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
							<Button Text="{loc:T AdminCreateGame_AddAtTheStart}" Clicked="OnAddAtStartClicked" HeightRequest="48"
							        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
							<Button Grid.Column="1" Text="{loc:T AdminCreateGame_Cancel}" Command="{Binding CancelModeCommand}" HeightRequest="48"
							        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
						</Grid>
					</VerticalStackLayout>

					<!-- Changing or removing: tap the sentence or picture. -->
					<VerticalStackLayout Spacing="8" IsVisible="{Binding IsSelecting}">
						<Label Text="{loc:T AdminCreateGame_TapToChange}" FontSize="13" TextColor="{StaticResource Warning}" IsVisible="{Binding IsChangingWords}" />
						<Label Text="{loc:T AdminCreateGame_TapToRemove}" FontSize="13" TextColor="{StaticResource Warning}" IsVisible="{Binding IsRemovingWords}" />
						<Button Text="{loc:T AdminCreateGame_Cancel}" Command="{Binding CancelModeCommand}" HeightRequest="48"
						        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
					</VerticalStackLayout>
				</VerticalStackLayout>

				<!-- The translation sentence by sentence: the original small above, a colour per status. -->
				<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SentenceRows}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="vm:SentenceRow">
							<VerticalStackLayout Spacing="0">
								<Grid IsVisible="{Binding IsSentence}">
								<Border Padding="10,8" StrokeThickness="1" Stroke="{StaticResource Border}">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="8" />
									</Border.StrokeShape>
									<Border.Triggers>
										<DataTrigger TargetType="Border" Binding="{Binding IsAuto}" Value="True">
											<Setter Property="BackgroundColor" Value="{StaticResource ScoreWarningTint}" />
										</DataTrigger>
										<DataTrigger TargetType="Border" Binding="{Binding IsReview}" Value="True">
											<Setter Property="BackgroundColor" Value="{StaticResource ScoreWarningTint}" />
											<Setter Property="Stroke" Value="{StaticResource ScoreWarning}" />
										</DataTrigger>
										<DataTrigger TargetType="Border" Binding="{Binding IsAdded}" Value="True">
											<Setter Property="Stroke" Value="{StaticResource Accent}" />
										</DataTrigger>
									</Border.Triggers>
									<Border.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnSentenceTapped" CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<VerticalStackLayout Spacing="4">
										<Label Text="{Binding Original}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
										<!-- One label per sentence; its words can be tapped while choosing what to change or remove. -->
										<views:WordsLabel Words="{Binding Words}" FontSize="15"
										                  TapCommand="{Binding TapWordCommand, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}" />
										<Label Text="{Binding StatusLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
										<!-- The original changed after a person checked it: the new automatic translation to compare with. -->
										<VerticalStackLayout Spacing="6" IsVisible="{Binding HasSuggestion}">
											<Label FontSize="13">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="{loc:T AdminCreateGame_Suggestion}" FontAttributes="Bold" />
														<Span Text="{Binding Segment.Suggestion}" />
													</FormattedString>
												</Label.FormattedText>
											</Label>
											<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
												<Button Text="{loc:T AdminCreateGame_TakeTheSuggestion}" HeightRequest="48" FontSize="13"
												        Command="{Binding TakeSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}"
												        CommandParameter="{Binding .}" />
												<Button Grid.Column="1" Text="{loc:T AdminCreateGame_KeepItAsItIs}" HeightRequest="48" FontSize="13"
												        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1"
												        Command="{Binding KeepTranslationCommand, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}"
												        CommandParameter="{Binding .}" />
											</Grid>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Border>
								<!-- Adding: the whole block is the place to add after (a tap on the words would otherwise go to them). -->
								<ContentView BackgroundColor="#01FFFFFF"
								             IsVisible="{Binding IsChoosingBlock, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}">
									<ContentView.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnSentenceTapped" CommandParameter="{Binding .}" />
									</ContentView.GestureRecognizers>
								</ContentView>
								</Grid>

								<!-- A picture, with its texts in this language to correct. -->
								<Grid IsVisible="{Binding IsPicture}">
								<VerticalStackLayout Spacing="8" Margin="0,6">
									<views:RulesImage ImageRef="{Binding PreviewRef}" />
									<VerticalStackLayout Spacing="8" IsVisible="{Binding HasTexts}">
										<Label Text="{loc:T AdminCreateGame_TextInThePicture}" FontSize="13" FontAttributes="Bold" />
										<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Texts}">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="vm:PictureText">
													<VerticalStackLayout Spacing="2">
														<Label Text="{Binding Original}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
														<Entry Text="{Binding Text}" />
													</VerticalStackLayout>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</VerticalStackLayout>
								<!-- Adding: the picture is the place to add after. -->
								<ContentView BackgroundColor="#01FFFFFF"
								             IsVisible="{Binding IsChoosingBlock, Source={RelativeSource AncestorType={x:Type vm:AdminCreateGameViewModel}}, x:DataType=vm:AdminCreateGameViewModel}">
									<ContentView.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnSentenceTapped" CommandParameter="{Binding .}" />
									</ContentView.GestureRecognizers>
								</ContentView>
								</Grid>
							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

				<Button Text="{loc:T AdminCreateGame_UseTheAutomaticTranslationAgain}" Command="{Binding UseAutomaticTranslationCommand}"
				        IsVisible="{Binding CanUseAutomaticTranslation}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Primary}" BorderWidth="1" />
			</VerticalStackLayout>

			<!-- On every page, away from the save button so they're never tapped by mistake. -->
			<Button Text="{loc:T AdminCreateGame_WithdrawRequest}" Margin="0,24,0,0" Clicked="OnWithdrawClicked" IsVisible="{Binding CanWithdraw}"
			        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />

			<Button Text="{Binding DeleteButtonText}" Clicked="OnDeleteClicked" IsVisible="{Binding CanDelete}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
			        BorderColor="{StaticResource Danger}" BorderWidth="1" />

		</VerticalStackLayout>
	</ScrollView>

	<!-- Always in view at the bottom: what's missing or happening, and the main action. Saving says what to fix
	     and opens the page it's on. -->
	<VerticalStackLayout x:Name="SaveBar" Grid.Row="2" BackgroundColor="{StaticResource SurfaceLight}" Spacing="0">
		<BoxView HeightRequest="1" Color="{StaticResource Border}" />
		<VerticalStackLayout Padding="20,8,20,12" Spacing="8">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasStatusMessage}">
				<ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}" Color="{StaticResource Primary}"
				                   HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
				<Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}" FontSize="13" />
			</Grid>
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<!-- On Translations: undo what was changed there. -->
				<Button Text="{loc:T AdminCreateGame_Discard}" Clicked="OnDiscardTranslationsClicked" HeightRequest="52" IsVisible="{Binding IsLanguagesPage}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Danger}" BorderWidth="1" />
				<Button Grid.Column="1" Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" HeightRequest="52" />
			</Grid>
		</VerticalStackLayout>
	</VerticalStackLayout>

	<!-- While a picture is being moved; stays in view at the bottom whatever is scrolled. -->
	<Border x:Name="MoveBar" Grid.Row="2" IsVisible="False" BackgroundColor="{StaticResource SurfaceMuted}"
	        StrokeThickness="0" Padding="16,10">
		<VerticalStackLayout Spacing="8">
			<Label Text="{loc:T AdminCreateGame_MovingPicture}" FontSize="13" FontAttributes="Bold" />
			<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
				<Button Text="{loc:T AdminCreateGame_Cancel}" Clicked="OnCancelMoveClicked" HeightRequest="48"
				        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
				<Button Grid.Column="1" Text="{loc:T AdminCreateGame_PlaceHere}" Clicked="OnPlaceHereClicked" HeightRequest="48" />
			</Grid>
		</VerticalStackLayout>
	</Border>
	</Grid>

</ContentPage>
