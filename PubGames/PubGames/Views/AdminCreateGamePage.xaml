<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.AdminCreateGamePage"
             x:DataType="vm:AdminCreateGameViewModel"
             Title="{Binding PageTitle}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="14">

			<!-- Moderators: what happens with their submission, or why it was rejected. -->
			<Border IsVisible="{Binding HasReviewInfo}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<Label Text="{Binding ReviewInfo}" FontSize="13" />
			</Border>

			<Label Text="Game name" FontSize="12" TextColor="{StaticResource TextSecondary}" />
			<Entry Placeholder="e.g. Kings cup" Text="{Binding Name}" />

			<Label Text="Cover image" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<!-- Square, like the icon in the game lists, so both show the same part of the picture. -->
			<Border IsVisible="{Binding HasCover}" StrokeThickness="0" WidthRequest="240" HeightRequest="240" HorizontalOptions="Center">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<Image Source="{Binding CoverImageUrl, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
			</Border>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Button Text="{Binding CoverButtonText}" Command="{Binding UploadCoverCommand}"
				        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
				<Button Grid.Column="1" Text="Remove" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
			</Grid>

			<Label Text="Pricing" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<HorizontalStackLayout Spacing="8">
				<CheckBox IsChecked="{Binding IsPaid}" />
				<Label Text="This game is paid" VerticalOptions="Center" />
			</HorizontalStackLayout>
			<Entry Placeholder="0,50" Text="{Binding Price}" Keyboard="Numeric" IsVisible="{Binding IsPaid}" />
			<Label Text="One-time price per player, you set this." FontSize="11" TextColor="{StaticResource TextSecondary}" />

			<Label Text="Scoring type" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Picker ItemsSource="{Binding ScoringTypeOptions}" SelectedItem="{Binding SelectedScoringOption}" />

			<!-- Plus / minus: the numbers the scoreboard uses. Each limit and the warning has its own switch. -->
			<Border IsVisible="{Binding IsPlusMinus}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Label Text="Every tap on + or − changes a player's score by the step." FontSize="12"
					       TextColor="{StaticResource TextSecondary}" />

					<Grid ColumnDefinitions="*,100" ColumnSpacing="12">
						<Label Text="Step (points per tap)" VerticalOptions="Center" />
						<Entry Grid.Column="1" Text="{Binding ScoreStep}" Keyboard="Numeric" HorizontalTextAlignment="End" />
					</Grid>

					<Grid ColumnDefinitions="*,100" ColumnSpacing="12">
						<Label Text="Starting score" VerticalOptions="Center" />
						<Entry Grid.Column="1" Text="{Binding StartScore}" Keyboard="Telephone" HorizontalTextAlignment="End" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Maximum score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMaxScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MaxScore}" Keyboard="Telephone" Placeholder="e.g. 10"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMaxScore}" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Minimum score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMinScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MinScore}" Keyboard="Telephone" Placeholder="e.g. 0"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMinScore}" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Warning at score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasWarningScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding WarningScore}" Keyboard="Telephone" Placeholder="e.g. 9"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasWarningScore}" />
					</Grid>
					<Label Text="On the scoreboard, a player at the warning gets a dashed orange border and a ⚠ WARNING badge; at the maximum or minimum the whole card turns dark blue with a ▲ MAX / ▼ MIN badge."
					       FontSize="11" TextColor="{StaticResource TextSecondary}" />
				</VerticalStackLayout>
			</Border>

			<!-- For every scoring type. How many subgames to play, the players choose when they start. -->
			<Label Text="Subgame results" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Label Text="Result of each subgame" />
					<Picker ItemsSource="{Binding ResultModeOptions}" SelectedItem="{Binding SelectedResultModeOption}" />
					<Label Text="{Binding ScoreDirectionTitle}" />
					<Picker ItemsSource="{Binding BestScoreOptions}" SelectedIndex="{Binding BestScoreIndex}" />
					<Label Text="After each subgame the app picks the winner(s), places or loser(s) from the scores; players can change that before confirming. Players can share a win, place or loss. How many subgames they play, the players choose (1 unless they change it)."
					       FontSize="11" TextColor="{StaticResource TextSecondary}" />
				</VerticalStackLayout>
			</Border>

			<!-- Tap to select; at least one. Players filter games by these. -->
			<Label Text="Categories (at least one)" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryChoices}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:CategoryChoice">
						<Border Margin="0,0,8,8" Padding="12,6" StrokeThickness="1" Stroke="{StaticResource Border}" BackgroundColor="Transparent">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="16" />
							</Border.StrokeShape>
							<Border.Triggers>
								<DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
									<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
									<Setter Property="Stroke" Value="{StaticResource Primary}" />
								</DataTrigger>
							</Border.Triggers>
							<Border.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}" />
							</Border.GestureRecognizers>
							<Label Text="{Binding Category.Name}" FontSize="13">
								<Label.Triggers>
									<DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
										<Setter Property="TextColor" Value="White" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<!-- The rules as players will see them: text boxes with the pictures shown in between. -->
			<Label Text="How to play" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RulesBlocks}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:EditableRulesBlock">
						<Grid>
							<Editor Text="{Binding Text}" IsVisible="{Binding IsText}" Placeholder="Explain the rules..."
							        AutoSize="TextChanges" MinimumHeightRequest="60" Focused="OnRulesEditorFocused" />
							<Grid IsVisible="{Binding IsImage}">
								<Border StrokeThickness="0">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="8" />
									</Border.StrokeShape>
									<Image Source="{Binding ImageRef, Converter={StaticResource ImageRefConverter}}"
									       Aspect="AspectFit" HorizontalOptions="Fill" MaximumHeightRequest="320" />
								</Border>
								<Button Text="✕" Clicked="OnRemoveRulesImageClicked"
								        HorizontalOptions="End" VerticalOptions="Start" Margin="6"
								        WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="18" FontSize="14"
								        BackgroundColor="{StaticResource Danger}" TextColor="White" />
							</Grid>
						</Grid>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
			<Button Text="Add picture here" Clicked="OnInsertRulesImageClicked"
			        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />
			<Label Text="Tap in the text where the picture should go, then tap Add picture here. You see it right away, just like players will. Tap ✕ to remove a picture."
			       FontSize="11" TextColor="{StaticResource TextSecondary}" />
			<ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}" Color="{StaticResource Primary}" />

			<Label Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}" Margin="0,6,0,0" />

			<Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0,10,0,0" />

			<Button Text="Withdraw request" Clicked="OnWithdrawClicked" IsVisible="{Binding CanWithdraw}"
			        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />

			<Button Text="{Binding DeleteButtonText}" Clicked="OnDeleteClicked" IsVisible="{Binding CanDelete}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
			        BorderColor="{StaticResource Danger}" BorderWidth="1" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
