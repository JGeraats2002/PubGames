<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:views="clr-namespace:PubGames.Views"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.AdminCreateGamePage"
             x:DataType="vm:AdminCreateGameViewModel"
             Title="{Binding PageTitle}">

	<Grid RowDefinitions="*,Auto">
	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="14">

			<!-- Moderators: what happens with their submission, or why it was rejected. -->
			<Border IsVisible="{Binding HasReviewInfo}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<Label Text="{Binding ReviewInfo}" FontSize="13" />
			</Border>

			<Label Text="Game name" FontSize="12" TextColor="{StaticResource TextSecondary}" />
			<Entry Placeholder="e.g. Kings cup" Text="{Binding Name}" />

			<Label Text="Cover image" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<!-- Square and as wide as the page, on every phone; the same part of the picture as the icon in the game lists. -->
			<Border IsVisible="{Binding HasCover}" StrokeThickness="0" HorizontalOptions="Fill" HeightRequest="{Binding Width, Source={RelativeSource Self}, x:DataType=Border}">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<Image Source="{Binding CoverImageUrl, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
			</Border>
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Button Text="{Binding CoverButtonText}" Clicked="OnCoverClicked"
				        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"
				        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
				<Button Grid.Column="1" Text="Remove" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}"
				        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
			</Grid>

			<Label Text="Pricing" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<HorizontalStackLayout Spacing="8">
				<CheckBox IsChecked="{Binding IsPaid}" />
				<Label Text="This game is paid" VerticalOptions="Center" />
			</HorizontalStackLayout>
			<Entry Placeholder="0,50" Text="{Binding Price}" Keyboard="Numeric" IsVisible="{Binding IsPaid}" />

			<Label Text="Scoring type" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Picker Title="Choose scoring type" ItemsSource="{Binding ScoringTypeOptions}" SelectedItem="{Binding SelectedScoringOption}" />

			<!-- Both plus / minus types: the numbers the scoreboard uses. Each limit and the warning has its own switch.
			     Plus / minus has a step; Manual plus / minus has rules for the amounts players type in. -->
			<Border IsVisible="{Binding HasScoreSettings}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsPlusMinus}">
						<Label Text="Step (points per tap)" VerticalOptions="Center" />
						<Entry Grid.Column="1" Text="{Binding ScoreStep}" Keyboard="Numeric" HorizontalTextAlignment="End" />
					</Grid>

					<Grid ColumnDefinitions="*,100" ColumnSpacing="12">
						<Label Text="Starting score" VerticalOptions="Center" />
						<Entry Grid.Column="1" Text="{Binding StartScore}" Keyboard="Telephone" HorizontalTextAlignment="End" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Maximum score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMaxScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MaxScore}" Keyboard="Telephone" Placeholder="e.g. 10"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMaxScore}" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Minimum score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMinScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MinScore}" Keyboard="Telephone" Placeholder="e.g. 0"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMinScore}" />
					</Grid>

					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Warning at score" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasWarningScore}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding WarningScore}" Keyboard="Telephone" Placeholder="e.g. 9"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasWarningScore}" />
					</Grid>

					<!-- Manual plus / minus: rules every typed amount must meet. -->
					<VerticalStackLayout Spacing="8" IsVisible="{Binding IsManual}" Margin="0,6,0,0">
						<Label Text="Rules for entered amounts" FontAttributes="Bold" />
						<VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding AmountRules}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:EditableScoreRule">
									<VerticalStackLayout Spacing="4">
									<Button Text="{Binding JoinerText}" Clicked="OnJoinerClicked" IsVisible="{Binding HasJoiner}"
									        HorizontalOptions="Start" HeightRequest="30" Padding="14,0" FontSize="12" FontAttributes="Bold"
									        BackgroundColor="{StaticResource PrimaryDark}" TextColor="White" />
									<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
										<Picker Title="Choose rule" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" VerticalOptions="Center" />
										<Entry Grid.Column="1" Text="{Binding Value}" Placeholder="{Binding ValuePlaceholder}" Keyboard="Telephone"
										       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding NeedsValue}" />
										<Entry Grid.Column="2" Text="{Binding Value2}" Placeholder="to" Keyboard="Telephone"
										       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding IsBetween}" />
										<Button Grid.Column="3" Text="✕" Clicked="OnRemoveAmountRuleClicked" WidthRequest="36" HeightRequest="36"
										        Padding="0" FontSize="14" VerticalOptions="Center"
										        BackgroundColor="Transparent" TextColor="{StaticResource Danger}" BorderColor="{StaticResource Border}" BorderWidth="1" />
									</Grid>
									</VerticalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
						<Label Text="{Binding AmountRulesPreview}" FontSize="12" FontAttributes="Bold" />
						<Button Text="+ Add rule" Clicked="OnAddAmountRuleClicked" HorizontalOptions="Start"
						        HeightRequest="36" Padding="14,0" FontSize="13"
						        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<!-- For every scoring type. How many subgames to play, the players choose when they start. -->
			<Label Text="Subgame results" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Label Text="Result of each subgame" />
					<Picker Title="Choose result of each subgame" ItemsSource="{Binding ResultModeOptions}" SelectedItem="{Binding SelectedResultModeOption}" />
					<Label Text="{Binding ScoreDirectionTitle}" />
					<Picker Title="{Binding ScoreDirectionPrompt}" ItemsSource="{Binding BestScoreOptions}" SelectedIndex="{Binding BestScoreIndex}" />
				</VerticalStackLayout>
			</Border>

			<!-- Each limit has its own switch. Both off: any number of players. Players filter games by this. -->
			<Label Text="Number of players" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Minimum players" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMinPlayers}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MinPlayers}" Keyboard="Numeric" Placeholder="e.g. 2"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMinPlayers}" />
					</Grid>
					<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
						<Label Text="Maximum players" VerticalOptions="Center" />
						<Switch Grid.Column="1" IsToggled="{Binding HasMaxPlayers}" VerticalOptions="Center" />
						<Entry Grid.Column="2" Text="{Binding MaxPlayers}" Keyboard="Numeric" Placeholder="e.g. 6"
						       HorizontalTextAlignment="End" IsVisible="{Binding HasMaxPlayers}" />
					</Grid>
					<Label Text="{Binding PlayersPreview}" FontSize="12" FontAttributes="Bold" />
				</VerticalStackLayout>
			</Border>

			<!-- Tap to select; at least one per main category. Players filter games by these. -->
			<Label Text="Categories" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CategoryChoiceGroups}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:CategoryChoiceGroup">
						<VerticalStackLayout Spacing="6">
							<Label Text="{Binding Title}" FontAttributes="Bold" />
							<views:CategoryClouds ItemsSource="{Binding Choices}" Placeholder="Choose one or more" CategoryTapped="OnCategoryTapped" />
						</VerticalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<!-- The rules. Pieces of text and pictures follow each other without anything in between, inside one box, so it
			     reads and types as one text. Hold a picture to edit, move or remove it. -->
			<Label Text="How to play" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0" />
			<Border Stroke="{StaticResource Border}" StrokeThickness="1" Padding="12,10" MinimumHeightRequest="140">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding RulesBlocks}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:EditableRulesBlock">
							<Grid>
								<views:PlainEditor Text="{Binding Text}" IsVisible="{Binding IsText}" Placeholder="{Binding Placeholder}"
								                   AutoSize="TextChanges" Focused="OnRulesEditorFocused" />
								<!-- The margin is the empty line above and below every picture. -->
								<views:RulesImage ImageRef="{Binding ImageRef}" IsVisible="{Binding IsImage}" Margin="0,14">
									<views:RulesImage.Behaviors>
										<views:TapAndHoldBehavior Held="OnRulesImageHeld" />
									</views:RulesImage.Behaviors>
								</views:RulesImage>
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</Border>
			<Label Text="Hold a picture to edit, move or remove it." FontSize="12" TextColor="{StaticResource TextSecondary}" />
			<Button Text="Add picture at the cursor" Clicked="OnInsertRulesImageClicked"
			        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />
			<ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}" Color="{StaticResource Primary}" />

			<Label Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}" Margin="0,6,0,0" />

			<Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0,10,0,0" />

			<Button Text="Withdraw request" Clicked="OnWithdrawClicked" IsVisible="{Binding CanWithdraw}"
			        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />

			<Button Text="{Binding DeleteButtonText}" Clicked="OnDeleteClicked" IsVisible="{Binding CanDelete}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
			        BorderColor="{StaticResource Danger}" BorderWidth="1" />

		</VerticalStackLayout>
	</ScrollView>

	<!-- While a picture is being moved; stays in view at the bottom whatever is scrolled. -->
	<Border x:Name="MoveBar" Grid.Row="1" IsVisible="False" BackgroundColor="{StaticResource SurfaceMuted}"
	        StrokeThickness="0" Padding="16,10">
		<VerticalStackLayout Spacing="8">
			<Label Text="Tap in the text where the picture should go, then tap Place here." FontSize="13" />
			<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
				<Button Text="Cancel" Clicked="OnCancelMoveClicked" HeightRequest="40"
				        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
				        BorderColor="{StaticResource Border}" BorderWidth="1" />
				<Button Grid.Column="1" Text="Place here" Clicked="OnPlaceHereClicked" HeightRequest="40" />
			</Grid>
		</VerticalStackLayout>
	</Border>
	</Grid>

</ContentPage>
