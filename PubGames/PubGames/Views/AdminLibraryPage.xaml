<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:views="clr-namespace:PubGames.Views"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.AdminLibraryPage"
             x:DataType="vm:AdminLibraryViewModel"
             Title="Library">

	<Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20" RowSpacing="12">

		<Button Grid.Row="0" Text="{Binding NewGameButtonText}" Clicked="OnNewGameClicked" />

		<Label Grid.Row="1" Text="{Binding SyncMessage}" FontSize="12" TextColor="{StaticResource Warning}" />

		<!-- Search by game name, and/or show one category. -->
		<VerticalStackLayout Grid.Row="2" Spacing="8">
			<!-- Search by name; the Filter button opens the filters (number of players, categories) and says how many are set. -->
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<SearchBar Placeholder="Search games" Text="{Binding SearchText}" />
			<Button Grid.Column="1" Text="{Binding Filters.ButtonText}" Clicked="OnFilterClicked"
			        HeightRequest="40" Padding="14,0" FontSize="13" VerticalOptions="Center"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Primary}" BorderWidth="1" />
		</Grid>
			<Label Text="{Binding ResultsText}" FontSize="12" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasResultsText}" />
		</VerticalStackLayout>

		<CollectionView Grid.Row="3" ItemsSource="{Binding Games}">
			<CollectionView.Header>
				<VerticalStackLayout Spacing="8">

					<!-- Admins: shortcut to the review requests. -->
					<Border IsVisible="{Binding HasRequestsToReview}" BackgroundColor="{StaticResource Accent}"
					        StrokeThickness="0" Padding="12,10" Margin="0,0,0,8">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnRequestsToReviewTapped" />
						</Border.GestureRecognizers>
						<Label Text="{Binding RequestsToReviewText}" TextColor="White" />
					</Border>

					<!-- Everyone on the team: shortcut to unread messages and review decisions. -->
					<Border IsVisible="{Binding HasUnreadMessages}" BackgroundColor="{StaticResource Primary}"
					        StrokeThickness="0" Padding="12,10" Margin="0,0,0,8">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnUnreadMessagesTapped" />
						</Border.GestureRecognizers>
						<Label Text="{Binding UnreadMessagesText}" TextColor="White" />
					</Border>

					<!-- Moderators: their requests still waiting for review (decisions go to the Inbox). -->
					<Label Text="My requests waiting for review" FontSize="16" IsVisible="{Binding HasMyRequests}" />
					<VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding MyRequests}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:ReviewRequest">
								<Border Padding="12,10" Stroke="{StaticResource Border}">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="8" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnMyRequestTapped" CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<VerticalStackLayout Spacing="2">
										<Label Text="{Binding Summary}" />
										<Label Text="{Binding StatusLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>

					<Label Text="Games" FontSize="16" Margin="0,10,0,0" IsVisible="{Binding HasMyRequests}" />
				</VerticalStackLayout>
			</CollectionView.Header>
			<CollectionView.EmptyView>
				<Label Text="No games yet. Tap the button above to add the first one."
				       TextColor="{StaticResource TextSecondary}" Margin="0,20,0,0" />
			</CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:PubGame">
					<!-- The same as in the players' library; tap to edit. -->
					<Grid Padding="10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnGameTapped" CommandParameter="{Binding .}" />
						</Grid.GestureRecognizers>
						<Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
						        BackgroundColor="{StaticResource SurfaceMuted}" VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<Image Source="{Binding CoverImageUrl, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
						</Border>
						<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
							<Label Text="{Binding Name}" />
							<Label Text="{Binding InfoLine}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
							<!-- Games from before main categories existed: what to fill in when editing them. -->
							<Label Text="{Binding MissingLabel}" FontSize="12" TextColor="{StaticResource Warning}" IsVisible="{Binding HasMissing}" />
							<!-- Moderators: another moderator's changes are waiting, so this game can't be changed for now. -->
							<Label Text="{Binding TakenLabel}" FontSize="12" TextColor="{StaticResource Primary}" IsVisible="{Binding IsTaken}" />
						</VerticalStackLayout>
						<Label Grid.Column="2" VerticalOptions="Center"
						       Text="{Binding Price, StringFormat='€{0:0.00}'}"
						       IsVisible="{Binding IsPaid}"
						       TextColor="{StaticResource Primary}" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>

</ContentPage>
