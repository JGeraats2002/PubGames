<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.AdminTeamPage"
             x:DataType="vm:AdminTeamViewModel"
             Title="Team">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16">

			<Label Text="{Binding StatusMessage}" TextColor="{StaticResource Danger}" FontSize="12" />

			<Label Text="Add a moderator" FontSize="16" />
			<Frame Padding="12" BorderColor="{StaticResource Border}">
				<VerticalStackLayout Spacing="8">
					<Entry Placeholder="Their Google account email" Text="{Binding NewModeratorEmail}"
					       Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
					<Button Text="Add moderator" Command="{Binding AddModeratorCommand}" />
				</VerticalStackLayout>
			</Frame>

			<Label Text="Team" FontSize="16" Margin="0,10,0,0" />
			<CollectionView ItemsSource="{Binding Members}">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:TeamMember">
						<Frame Margin="0,0,0,8" Padding="12" BorderColor="{StaticResource Border}">
							<VerticalStackLayout Spacing="6">
								<Label Text="{Binding Label}" />
								<Label FontSize="11" TextColor="{StaticResource TextSecondary}">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding RoleName}" />
											<Span Text=" · " />
											<Span Text="{Binding Email}" />
										</FormattedString>
									</Label.FormattedText>
								</Label>

								<HorizontalStackLayout Spacing="8" IsVisible="{Binding HasActions}">
									<Button Text="Make admin" Clicked="OnMakeAdminClicked" IsVisible="{Binding CanPromote}"
									        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
									        BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="12" />
									<Button Text="Make moderator" Clicked="OnMakeModeratorClicked" IsVisible="{Binding CanDemote}"
									        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
									        BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="12" />
									<Button Text="Remove" Clicked="OnRemoveClicked" IsVisible="{Binding CanRemove}"
									        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
									        BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="12" />
								</HorizontalStackLayout>
							</VerticalStackLayout>
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
