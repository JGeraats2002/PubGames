<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.CategoryGamesPage"
             x:DataType="vm:CategoryGamesViewModel"
             Title="{Binding Title}">

	<Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20" RowSpacing="12">

		<Label Text="{Binding Explanation}" FontSize="13" TextColor="{StaticResource TextSecondary}" />

		<CollectionView Grid.Row="1" ItemsSource="{Binding Games}">
			<CollectionView.EmptyView>
				<Label Text="There are no published games yet." TextColor="{StaticResource TextSecondary}" />
			</CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="vm:GameChoice">
					<Grid ColumnDefinitions="Auto,*" Padding="0,4">
						<CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
						<Label Grid.Column="1" Text="{Binding Game.Name}" VerticalOptions="Center" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Label Grid.Row="2" Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}" FontSize="12" />

		<Button Grid.Row="3" Text="Save games in category" Clicked="OnSaveClicked" IsEnabled="{Binding CanSave}" />

	</Grid>

</ContentPage>
