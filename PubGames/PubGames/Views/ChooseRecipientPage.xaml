<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.ChooseRecipientPage"
             Title="Send a message to">

	<Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">

		<SearchBar x:Name="Search" Placeholder="Search by name or email" TextChanged="OnSearchChanged" />

		<CollectionView Grid.Row="1" x:Name="List">
			<CollectionView.EmptyView>
				<Label Text="Nobody found." TextColor="{StaticResource TextSecondary}" />
			</CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="vm:MessageRecipient">
					<VerticalStackLayout Padding="10" Spacing="2">
						<VerticalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnRecipientTapped" CommandParameter="{Binding .}" />
						</VerticalStackLayout.GestureRecognizers>
						<Label Text="{Binding Label}" FontSize="16" />
						<Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>

</ContentPage>
