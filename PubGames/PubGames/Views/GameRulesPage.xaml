<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             xmlns:views="clr-namespace:PubGames.Views"
             x:Class="PubGames.Views.GameRulesPage"
             x:DataType="vm:GameRulesViewModel"
             Title="{Binding GameName}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="14">

			<!-- A paid game that isn't unlocked: its rules can be read; Unlock comes instead of Skip rules and Start game. -->
			<Button Text="🔒 Unlock to play" Clicked="OnUnlockClicked" IsVisible="{Binding IsLocked}" />

			<!-- How many subgames make up the game (1 unless changed); used by both Skip rules and Start game. -->
			<Border BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12" IsVisible="{Binding IsUnlocked}">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="6">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
						<Label Text="Play" VerticalOptions="Center" />
						<Button Grid.Column="1" Text="−" Clicked="OnFewerSubgamesClicked" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="18"
						        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
						<Label Grid.Column="2" Text="{Binding SubgameCountText}" FontAttributes="Bold" WidthRequest="100"
						       HorizontalTextAlignment="Center" VerticalOptions="Center" />
						<Button Grid.Column="3" Text="+" Clicked="OnMoreSubgamesClicked" WidthRequest="40" HeightRequest="40" Padding="0" FontSize="18"
						        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- For groups who already know the game. -->
			<Button Text="Skip rules" Command="{Binding StartGameCommand}" IsVisible="{Binding IsUnlocked}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Primary}" BorderWidth="1" />

			<!-- Square and as wide as the page, on every phone; the same part of the picture as the icon in the game lists. -->
			<Border StrokeThickness="0" HorizontalOptions="Fill" HeightRequest="{Binding Width, Source={RelativeSource Self}, x:DataType=Border}" Margin="0,6,0,0"
			        IsVisible="{Binding HasCover}">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="10" />
				</Border.StrokeShape>
				<Image Source="{Binding CoverImageRef, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
			</Border>

			<Label Text="{Binding GameName}" FontSize="24" FontAttributes="Bold" Margin="0,6,0,0" />
			<Label Text="{Binding PlayerCountLabel}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
			<Label Text="{Binding PlayersSummary}" FontSize="13" TextColor="{StaticResource TextSecondary}" />

			<Label Text="How to play" FontSize="16" Margin="0,10,0,0" />
			<VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding RulesBlocks}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:RulesBlock">
						<Grid>
							<Label Text="{Binding Text}" IsVisible="{Binding IsText}" FontSize="15" LineHeight="1.3" />
							<views:RulesImage ImageRef="{Binding ImageRef}" IsVisible="{Binding IsImage}" />
						</Grid>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<Button Text="Start game" Command="{Binding StartGameCommand}" Margin="0,20,0,0" IsVisible="{Binding IsUnlocked}" />
			<Button Text="🔒 Unlock to play" Clicked="OnUnlockClicked" Margin="0,20,0,0" IsVisible="{Binding IsLocked}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
