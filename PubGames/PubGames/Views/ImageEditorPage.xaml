<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             x:Class="PubGames.Views.ImageEditorPage"
             Title="{loc:T ImageEditor_CreateImage}">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="10">

		<!-- Undo takes back the last change; the ⓘ explains the editor. -->
		<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
			<Label x:Name="Heading" Text="{loc:T ImageEditor_CreateImage}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
			<Button Grid.Column="1" Text="{loc:T ImageEditor_Undo}" Clicked="OnUndoClicked" HeightRequest="48" Padding="14,0" FontSize="13"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />
			<Button SemanticProperties.Description="{loc:T ImageEditor_Help}" Grid.Column="2" Text="ⓘ" Clicked="OnInfoClicked" HeightRequest="48" WidthRequest="48" Padding="0" FontSize="16"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />
		</Grid>

		<!-- What can be added to the drawing. -->
		<ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
			<HorizontalStackLayout x:Name="AddButtons" Spacing="6" />
		</ScrollView>

		<!-- The drawing: tap to select, drag to move, two fingers to resize and turn. -->
		<Border Grid.Row="2" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="0" HorizontalOptions="Center">
			<GraphicsView x:Name="Canvas"
			              StartInteraction="OnCanvasTouchStarted"
			              DragInteraction="OnCanvasTouchMoved"
			              EndInteraction="OnCanvasTouchEnded" />
		</Border>

		<!-- The choices for the selected item; filled in by the page. -->
		<ScrollView Grid.Row="3">
			<VerticalStackLayout x:Name="Options" Spacing="10" />
		</ScrollView>

		<Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
			<Button Text="{loc:T ImageEditor_Cancel}" Clicked="OnCancelClicked"
			        BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
			        BorderColor="{StaticResource Border}" BorderWidth="1" />
			<Button Grid.Column="1" Text="{loc:T ImageEditor_UseThisImage}" Clicked="OnUseClicked" />
		</Grid>

	</Grid>

</ContentPage>
