<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.InboxPage"
             x:DataType="vm:InboxViewModel"
             Title="Inbox">

	<Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">

		<Button Text="+ New message" Clicked="OnNewMessageClicked" />

		<Label Grid.Row="1" Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource Warning}" />

		<CollectionView Grid.Row="2" ItemsSource="{Binding Messages}">
			<CollectionView.EmptyView>
				<Label Text="No messages. Review decisions and messages from your team arrive here."
				       TextColor="{StaticResource TextSecondary}" Margin="0,20,0,0" />
			</CollectionView.EmptyView>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:InboxMessage">
					<Border Margin="0,0,0,8" Padding="12" Stroke="{StaticResource Border}">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="8" />
						</Border.StrokeShape>
						<VerticalStackLayout Spacing="6">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<Label Text="{Binding Heading}" FontAttributes="Bold" />
								<Border Grid.Column="1" IsVisible="{Binding IsUnread}" BackgroundColor="{StaticResource Accent}"
								        StrokeThickness="0" Padding="6,1" VerticalOptions="Start">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="4" />
									</Border.StrokeShape>
									<Label Text="New" TextColor="White" FontSize="11" />
								</Border>
							</Grid>
							<Label Text="{Binding SentLabel}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
							<Label Text="{Binding Text}" FontSize="14" />
							<HorizontalStackLayout Spacing="8">
								<Button Text="Edit and submit again" Clicked="OnResubmitClicked" IsVisible="{Binding OffersResubmit}"
								        FontSize="12" Padding="10,0" HeightRequest="36" />
								<Button Text="Reply" Clicked="OnReplyClicked"
								        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
								        BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="12" Padding="10,0" HeightRequest="36" />
								<Button Text="Delete" Clicked="OnDeleteClicked"
								        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
								        BorderColor="{StaticResource Border}" BorderWidth="1" FontSize="12" Padding="10,0" HeightRequest="36" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>

</ContentPage>
