<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.PlayerEntryPage"
             x:DataType="vm:PlayerEntryViewModel"
             Title="Who's playing?">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16">

			<Label Text="Who's playing?" FontSize="22" />
			<Label Text="Add players for this session" TextColor="{StaticResource TextSecondary}" FontSize="13" />

			<CollectionView ItemsSource="{Binding SelectedPlayers}">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Player">
						<Grid Padding="10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Frame WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"
							       BackgroundColor="{StaticResource SurfaceMuted}" VerticalOptions="Center">
								<Label Text="{Binding AvatarInitials}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
							</Frame>
							<Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
							<Label Grid.Column="2" Text="✕" TextColor="{StaticResource TextSecondary}"
							       VerticalOptions="Center">
								<Label.GestureRecognizers>
									<TapGestureRecognizer
										Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerEntryViewModel}}, Path=RemoveSelectedPlayerCommand}"
										CommandParameter="{Binding .}" />
								</Label.GestureRecognizers>
							</Label>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Entry Grid.Column="0" Placeholder="Add player name" Text="{Binding NewPlayerName}" />
				<Button Grid.Column="1" Text="Add" Command="{Binding AddNewPlayerCommand}" />
			</Grid>

			<Label Text="Saved players" FontSize="12" TextColor="{StaticResource TextSecondary}" />
			<FlexLayout BindableLayout.ItemsSource="{Binding SavedPlayers}" Wrap="Wrap">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:Player">
						<Frame Margin="0,0,6,6" Padding="10,5" CornerRadius="16" BorderColor="{StaticResource Border}">
							<Frame.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerEntryViewModel}}, Path=AddSavedPlayerCommand}"
									CommandParameter="{Binding .}" />
							</Frame.GestureRecognizers>
							<Label Text="{Binding Name}" FontSize="13" />
						</Frame>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<Button Text="Choose a game" Clicked="OnChooseGameClicked" Margin="0,20,0,0" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
