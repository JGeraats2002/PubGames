<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             xmlns:views="clr-namespace:PubGames.Views"
             x:Class="PubGames.Views.PlayerEntryPage"
             x:DataType="vm:PlayerEntryViewModel"
             Title="{loc:T PlayerEntry_WhoSPlaying}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16">

			<!-- Saved games are on their own page. -->
			<Grid ColumnDefinitions="*,Auto">
				<Label Text="{loc:T PlayerEntry_WhoSPlaying}" FontSize="22" VerticalOptions="Center" />
				<Button Grid.Column="1" Text="{Binding SavedGamesButtonText}" Clicked="OnSavedGamesClicked"
				        HeightRequest="48" Padding="14,0" FontSize="13" VerticalOptions="Center"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
			</Grid>

			<CollectionView ItemsSource="{Binding SelectedPlayers}">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:Player">
						<!-- Tap a player to take them out; they go back to Saved players. ✎ renames, ▲ ▼ change the seat order. -->
						<Grid Padding="10,4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
							<Grid.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerEntryViewModel}}, Path=RemoveSelectedPlayerCommand}"
									CommandParameter="{Binding .}" />
							</Grid.GestureRecognizers>
							<Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" Padding="0"
							        BackgroundColor="{StaticResource SurfaceMuted}" VerticalOptions="Center">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="18" />
								</Border.StrokeShape>
								<Grid>
									<Label Text="{Binding AvatarInitials}" FontSize="12" IsVisible="{Binding HasNoPhoto}"
									       HorizontalOptions="Center" VerticalOptions="Center" />
									<Image Source="{Binding PhotoRef, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill"
									       IsVisible="{Binding HasPhoto}" />
								</Grid>
							</Border>
							<Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
							<Button SemanticProperties.Description="{loc:T PlayerEntry_RenamePlayer}" Grid.Column="2" Text="✎" Clicked="OnRenameClicked" WidthRequest="48" HeightRequest="48" Padding="0"
							        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
							<Button SemanticProperties.Description="{loc:T PlayerEntry_MoveUp}" Grid.Column="3" Text="▲" Clicked="OnMoveUpClicked" WidthRequest="48" HeightRequest="48" Padding="0"
							        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
							<Button SemanticProperties.Description="{loc:T PlayerEntry_MoveDown}" Grid.Column="4" Text="▼" Clicked="OnMoveDownClicked" WidthRequest="48" HeightRequest="48" Padding="0"
							        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Entry Grid.Column="0" Placeholder="{loc:T PlayerEntry_AddPlayerName}" Text="{Binding NewPlayerName}" />
				<Button Grid.Column="1" Text="{loc:T PlayerEntry_Add}" Command="{Binding AddNewPlayerCommand}" />
			</Grid>

			<!-- Someone's personal code (under Account > Profile): the game then counts in their stats. -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<Entry Grid.Column="0" Placeholder="{loc:T PlayerEntry_AddByPlayerCode}" Text="{Binding PlayerCode}"
				       Keyboard="Text" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="12" />
				<Button Grid.Column="1" Text="{loc:T PlayerEntry_Add}" Command="{Binding AddByCodeCommand}" />
			</Grid>
			<Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextColor="{StaticResource Warning}" FontAttributes="Bold" />

			<Label Text="{loc:T PlayerEntry_SavedPlayers}" FontSize="16" IsVisible="{Binding HasSavedPlayers}" />
			<FlexLayout BindableLayout.ItemsSource="{Binding SavedPlayers}" Wrap="Wrap">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:Player">
						<!-- Tap: add to the game. Hold: delete from the saved players (asks first). -->
						<Frame Margin="0,0,6,6" Padding="4,4,10,4" CornerRadius="16" BorderColor="{StaticResource Border}">
							<Frame.Behaviors>
								<views:TapAndHoldBehavior Tapped="OnSavedPlayerTapped" Held="OnSavedPlayerHeld" />
							</Frame.Behaviors>
							<HorizontalStackLayout Spacing="6">
								<Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" Padding="0"
								        BackgroundColor="{StaticResource SurfaceMuted}" VerticalOptions="Center">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="12" />
									</Border.StrokeShape>
									<Grid>
										<Label Text="{Binding AvatarInitials}" FontSize="9" IsVisible="{Binding HasNoPhoto}"
										       HorizontalOptions="Center" VerticalOptions="Center" />
										<Image Source="{Binding PhotoRef, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill"
										       IsVisible="{Binding HasPhoto}" />
									</Grid>
								</Border>
								<Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Frame>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<Button Text="{loc:T PlayerEntry_ChooseAGame}" Clicked="OnChooseGameClicked" Margin="0,20,0,0" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
