<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             xmlns:views="clr-namespace:PubGames.Views"
             x:Class="PubGames.Views.ReviewRequestPage"
             x:DataType="vm:ReviewRequestViewModel"
             Title="{Binding TypeLabel}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="12">

			<Label Text="{Binding Headline}" FontSize="17" />
			<Label Text="{Binding SubmittedLabel}" FontSize="12" TextColor="{StaticResource TextSecondary}" />

			<!-- Changes to a game: what exactly would change. -->
			<Border IsVisible="{Binding HasChanges}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12,10" Margin="0,6,0,0">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="4">
					<Label Text="{loc:T ReviewRequest_WhatChanges}" FontAttributes="Bold" />
					<VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Changes}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="x:String">
								<Label Text="{Binding StringFormat='• {0}'}" FontSize="13" />
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<!-- Translations it touches, with who on the team uses the app in each language. -->
			<Border IsVisible="{Binding HasTranslationChanges}" BackgroundColor="{StaticResource SurfaceMuted}"
			        StrokeThickness="0" Padding="12,10">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Label Text="{loc:T ReviewRequest_Translations}" FontAttributes="Bold" />
					<Label Text="{loc:T ReviewRequest_TranslationsHint}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
					<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding TranslationChanges}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:TranslationChange">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
									<Border WidthRequest="28" HeightRequest="28" StrokeThickness="1" Stroke="{StaticResource Border}"
									        StrokeShape="Ellipse" VerticalOptions="Start">
										<Image Source="{Binding Flag}" Aspect="AspectFill" />
									</Border>
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" />
										<Label Text="{Binding Speakers}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
									</VerticalStackLayout>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<!-- Every change, sentence by sentence: first how it was, then how it would become. -->
			<VerticalStackLayout Spacing="10" IsVisible="{Binding HasSentenceChanges}">
				<Label Text="{loc:T ReviewRequest_Changes}" FontSize="16" />
				<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SentenceChanges}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:SentenceChange">
							<Border Padding="12,10" StrokeThickness="1" Stroke="{StaticResource Border}">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="8" />
								</Border.StrokeShape>
								<VerticalStackLayout Spacing="6">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
										<Border WidthRequest="22" HeightRequest="22" StrokeThickness="1" Stroke="{StaticResource Border}" StrokeShape="Ellipse">
											<Image Source="{Binding Flag}" Aspect="AspectFill" />
										</Border>
										<Label Grid.Column="1" Text="{Binding Heading}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
									</Grid>
									<VerticalStackLayout Spacing="2" IsVisible="{Binding HasBefore}">
										<Label Text="{loc:T ReviewRequest_Before}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
										<Label Text="{Binding Before}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
									</VerticalStackLayout>
									<VerticalStackLayout Spacing="2" IsVisible="{Binding HasBeforeImage}">
										<Label Text="{loc:T ReviewRequest_Before}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
										<views:RulesImage ImageRef="{Binding BeforeImage}" />
									</VerticalStackLayout>
									<VerticalStackLayout Spacing="2" IsVisible="{Binding HasAfter}">
										<Label Text="{loc:T ReviewRequest_After}" FontSize="11" TextColor="{StaticResource Accent}" />
										<Label Text="{Binding After}" FontSize="14" />
									</VerticalStackLayout>
									<VerticalStackLayout Spacing="2" IsVisible="{Binding HasAfterImage}">
										<Label Text="{loc:T ReviewRequest_After}" FontSize="11" TextColor="{StaticResource Accent}" />
										<views:RulesImage ImageRef="{Binding AfterImage}" />
									</VerticalStackLayout>
								</VerticalStackLayout>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
				<Button Text="{Binding FullGameButtonText}" Command="{Binding ToggleFullGameCommand}" HeightRequest="48"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
			</VerticalStackLayout>

			<Label Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}" />

			<!-- A moderator looking at another moderator's request: nothing to decide, but they can get in touch. -->
			<VerticalStackLayout Spacing="8" IsVisible="{Binding IsReadOnly}">
				<Label Text="{loc:T ReviewRequest_ThisIsWaitingForAn}" FontSize="13" />
				<Button Text="{loc:T ReviewRequest_SendThemAMessage}" Clicked="OnMessageClicked"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Primary}" BorderWidth="1" />
			</VerticalStackLayout>

			<Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding CanDecide}">
				<Button Text="{loc:T ReviewRequest_Reject}" Clicked="OnRejectClicked"
				        BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
				        BorderColor="{StaticResource Danger}" BorderWidth="1" />
				<Button Grid.Column="1" Text="{Binding ApproveButtonText}" Clicked="OnApproveClicked"
				        IsEnabled="{Binding CanApprove}" />
			</Grid>

			<!-- The whole game: shown at once for new games, behind a button when there's a list of changes. -->
			<VerticalStackLayout Spacing="12" IsVisible="{Binding ShowFullGame}">
			<!-- The original and a translation piece by piece, each with its flag, to judge the translation. -->
			<VerticalStackLayout Spacing="10" IsVisible="{Binding HasComparison}" Margin="0,16,0,0">
				<Label Text="{loc:T ReviewRequest_CompareTheTranslation}" FontSize="16" />
				<Picker Title="{loc:T ReviewRequest_ChooseATranslation}" ItemsSource="{Binding CompareLanguages}"
				        ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding CompareLanguage}" />
				<VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ComparisonRows}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:ComparisonRow">
							<VerticalStackLayout Spacing="6">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsText}">
									<Border WidthRequest="22" HeightRequest="22" StrokeThickness="1" Stroke="{StaticResource Border}" StrokeShape="Ellipse" VerticalOptions="Start">
										<Image Source="{Binding OriginalFlag, Source={RelativeSource AncestorType={x:Type vm:ReviewRequestViewModel}}, x:DataType=vm:ReviewRequestViewModel}" Aspect="AspectFill" />
									</Border>
									<Label Grid.Column="1" Text="{Binding Original}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
								</Grid>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsText}">
									<Border WidthRequest="22" HeightRequest="22" StrokeThickness="1" Stroke="{StaticResource Border}" StrokeShape="Ellipse" VerticalOptions="Start">
										<Image Source="{Binding CompareFlag, Source={RelativeSource AncestorType={x:Type vm:ReviewRequestViewModel}}, x:DataType=vm:ReviewRequestViewModel}" Aspect="AspectFill" />
									</Border>
									<Label Grid.Column="1" Text="{Binding Translation}" FontSize="15" />
								</Grid>
								<Label Text="{loc:T ReviewRequest_NotTranslated}" FontSize="12" TextColor="{StaticResource Warning}" IsVisible="{Binding HasNoTranslation}" />
								<views:RulesImage ImageRef="{Binding ImageRef}" IsVisible="{Binding IsImage}" />
								<BoxView HeightRequest="1" Color="{StaticResource Border}" IsVisible="{Binding IsText}" />
							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</VerticalStackLayout>

			<!-- Preview, laid out like the rules page players see. Not for category requests. -->
			<VerticalStackLayout Spacing="12" IsVisible="{Binding HasGamePreview}">
			<!-- Changes to a game: switch the preview between the game as it is and with the changes. -->
			<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,16,0,0" IsVisible="{Binding CanSwitch}">
				<Button Text="{loc:T ReviewRequest_Original}" Clicked="OnShowOriginalClicked" HeightRequest="48"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Primary}" BorderWidth="1">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding ShowingOriginal}" Value="True">
							<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
							<Setter Property="TextColor" Value="White" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
				<Button Grid.Column="1" Text="{loc:T ReviewRequest_WithChanges}" Clicked="OnShowChangedClicked" HeightRequest="48"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
				        BorderColor="{StaticResource Primary}" BorderWidth="1">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding ShowingOriginal}" Value="False">
							<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
							<Setter Property="TextColor" Value="White" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
			</Grid>
			<Label Text="{Binding PreviewTitle}" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="0,6,0,0" />
			<Border StrokeThickness="0" HorizontalOptions="Fill" HeightRequest="{Binding Width, Source={RelativeSource Self}, x:DataType=Border}"
			        IsVisible="{Binding PreviewHasCover}">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="10" />
				</Border.StrokeShape>
				<Image Source="{Binding Preview.CoverImageUrl, Converter={StaticResource ImageRefConverter}}" Aspect="AspectFill" />
			</Border>
			<Label Text="{Binding Preview.Name}" FontSize="24" FontAttributes="Bold" />
			<Label FontSize="13" TextColor="{StaticResource TextSecondary}">
				<Label.FormattedText>
					<FormattedString>
						<Span Text="{Binding Preview.PriceLabel}" />
						<Span Text=" · " />
						<Span Text="{Binding Preview.ScoringLabel}" />
					</FormattedString>
				</Label.FormattedText>
			</Label>
			<Label FontSize="13" TextColor="{StaticResource TextSecondary}">
				<Label.FormattedText>
					<FormattedString>
						<Span Text="{loc:T ReviewRequest_Players}" />
						<Span Text="{Binding Preview.PlayersLabel}" />
						<Span Text="{loc:T ReviewRequest_Categories}" />
						<Span Text="{Binding PreviewCategories}" />
					</FormattedString>
				</Label.FormattedText>
			</Label>

			<Label Text="{loc:T ReviewRequest_HowToPlay}" FontSize="16" Margin="0,10,0,0" />
			<VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PreviewRules}">
				<BindableLayout.EmptyView>
					<Label Text="{loc:T ReviewRequest_NoRulesWritten}" TextColor="{StaticResource TextSecondary}" />
				</BindableLayout.EmptyView>
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:RulesBlock">
						<Grid>
							<Label Text="{Binding Text}" IsVisible="{Binding IsText}" FontSize="15" LineHeight="1.3" />
							<views:RulesImage ImageRef="{Binding ImageRef}" IsVisible="{Binding IsImage}" />
						</Grid>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
			</VerticalStackLayout>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
