<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.SavedGamesPage"
             x:DataType="vm:SavedGamesViewModel"
             Title="Saved games">

	<ContentPage.Resources>
		<!-- The two pages: the open one filled, the other outlined. -->
		<Style x:Key="TabButton" TargetType="Button">
			<Setter Property="BackgroundColor" Value="Transparent" />
			<Setter Property="TextColor" Value="{StaticResource Primary}" />
			<Setter Property="BorderColor" Value="{StaticResource Border}" />
			<Setter Property="BorderWidth" Value="1" />
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="HeightRequest" Value="40" />
			<Setter Property="FontSize" Value="14" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="10">

		<!-- Unfinished games first, finished games on their own page. -->
		<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
			<Button Text="{Binding UnfinishedTabText}" Style="{StaticResource TabButton}" Clicked="OnUnfinishedTabClicked">
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding ShowsUnfinished}" Value="True">
						<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
						<Setter Property="TextColor" Value="White" />
					</DataTrigger>
				</Button.Triggers>
			</Button>
			<Button Grid.Column="1" Text="{Binding FinishedTabText}" Style="{StaticResource TabButton}" Clicked="OnFinishedTabClicked">
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding ShowsFinished}" Value="True">
						<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
						<Setter Property="TextColor" Value="White" />
					</DataTrigger>
				</Button.Triggers>
			</Button>
		</Grid>

		<!-- How long the open page's games are kept on this phone. -->
		<Border Grid.Row="1" BackgroundColor="{StaticResource SurfaceMuted}" StrokeThickness="0" Padding="12,8">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="8" />
			</Border.StrokeShape>
			<VerticalStackLayout Spacing="4">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<Label Text="{Binding RetentionTitle}" VerticalOptions="Center" FontAttributes="Bold" />
					<Picker Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetention}" MinimumWidthRequest="150" />
				</Grid>
			</VerticalStackLayout>
		</Border>

		<!-- Select: choose games to delete. -->
		<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
			<Button Text="{Binding SelectButtonText}" Clicked="OnSelectClicked" HorizontalOptions="Start"
			        HeightRequest="48" Padding="14,0" FontSize="13"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" />
			<Button Grid.Column="1" Text="Select all" Clicked="OnSelectAllClicked" IsVisible="{Binding IsSelecting}"
			        HeightRequest="48" Padding="10,0" FontSize="13"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
			<Button Grid.Column="2" Text="Deselect all" Clicked="OnDeselectAllClicked" IsVisible="{Binding IsSelecting}"
			        HeightRequest="48" Padding="10,0" FontSize="13"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
		</Grid>

		<ScrollView Grid.Row="3">
			<VerticalStackLayout Spacing="8">
				<Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
				       TextColor="{StaticResource TextSecondary}" Margin="0,20,0,0" />
				<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="vm:SavedGameRow">
							<Border Padding="12,8" Stroke="{StaticResource Border}" StrokeThickness="1">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="10" />
								</Border.StrokeShape>
								<Border.GestureRecognizers>
									<TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding .}" />
								</Border.GestureRecognizers>
								<Border.Triggers>
									<DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
										<Setter Property="Stroke" Value="{StaticResource Primary}" />
										<Setter Property="StrokeThickness" Value="3" />
									</DataTrigger>
								</Border.Triggers>
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
									<CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"
									          IsVisible="{Binding IsSelecting, Source={RelativeSource AncestorType={x:Type vm:SavedGamesViewModel}}, x:DataType=vm:SavedGamesViewModel}" />
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label Text="{Binding Game.GameName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
										<Label Text="{Binding Game.Players}" FontSize="12" LineBreakMode="TailTruncation" />
										<Label Text="{Binding Game.Details}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
									</VerticalStackLayout>
									<Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource Primary}" VerticalOptions="Center"
									       IsVisible="{Binding IsBrowsing, Source={RelativeSource AncestorType={x:Type vm:SavedGamesViewModel}}, x:DataType=vm:SavedGamesViewModel}" />
								</Grid>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<Button Grid.Row="4" Text="{Binding DeleteButtonText}" Clicked="OnDeleteClicked" IsVisible="{Binding HasSelection}"
		        BackgroundColor="{StaticResource Danger}" />

	</Grid>

</ContentPage>
