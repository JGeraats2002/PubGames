<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.ScoreboardPage"
             x:DataType="vm:ScoreboardViewModel"
             Title="{Binding GameName}">

	<Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="10">

		<VerticalStackLayout x:Name="Header" Spacing="2">
			<!-- − / + change how many subgames the game has, e.g. when the winner isn't clear after 1 game. -->
			<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
				<Label Text="{Binding SubgameLabel}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
				<Button Grid.Column="1" Text="{loc:T Scoreboard_Subgame}" Clicked="OnFewerSubgamesClicked" IsVisible="{Binding CanHaveFewerSubgames}"
				        HeightRequest="48" Padding="10,0" FontSize="12"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
				<Button Grid.Column="2" Text="{loc:T Scoreboard_Subgame2}" Clicked="OnMoreSubgamesClicked"
				        IsVisible="{Binding IsFinished, Converter={StaticResource InvertedBoolConverter}}"
				        HeightRequest="48" Padding="10,0" FontSize="12"
				        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Border}" BorderWidth="1" />
			</Grid>
			<!-- Manual plus / minus: why an amount wasn't accepted. A fixed height, so the cards don't jump. -->
			<Label x:Name="ScoreMessage" IsVisible="False" HeightRequest="38" FontSize="13" FontAttributes="Bold"
			       TextColor="{StaticResource Danger}" LineBreakMode="WordWrap" MaxLines="2" />
			<!-- The end score: who reached it, and what happens now. -->
			<Label Text="{Binding EndMessage}" IsVisible="{Binding HasEndMessage}" FontSize="13" FontAttributes="Bold"
			       TextColor="{StaticResource PrimaryDark}" LineBreakMode="WordWrap" MaxLines="2" />
			<!-- Fixed input order with + and − by a step: the player whose turn it is taps this when they're done. -->
			<Button x:Name="TurnDoneButton" Text="{loc:T Scoreboard_TurnDone}" Clicked="OnTurnDoneClicked" IsVisible="False"
			        HeightRequest="48" Padding="12,0" FontSize="13" HorizontalOptions="End" />
		</VerticalStackLayout>

		<!-- One card per player, all on screen at once: filled in by ScoreboardPage.xaml.cs,
		     which gives every card an exact height so they fit the screen (two columns above 8 players).
		     While typing an amount the keyboard takes part of the screen: the board then scrolls,
		     and the card being typed in is scrolled into view. -->
		<ScrollView Grid.Row="1" x:Name="BoardScroll">
			<Grid x:Name="Board" RowSpacing="8" ColumnSpacing="8" VerticalOptions="Start" />
		</ScrollView>

		<!-- Next subgame / Finish game share the bottom row; UpdateFooter gives the visible one(s) the width. -->
		<Grid Grid.Row="2" x:Name="Footer" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
			<Button Text="{loc:T Scoreboard_ChangePlayers}" Clicked="OnChangePlayersClicked"
			        IsVisible="{Binding IsFinished, Converter={StaticResource InvertedBoolConverter}}"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Primary}" BorderWidth="1" />
			<Button Grid.Column="1" x:Name="StatsButton" Text="{loc:T Scoreboard_Stats}" Clicked="OnStatsClicked"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Primary}" BorderWidth="1" />
			<Button Grid.Row="1" x:Name="NextButton" Text="{loc:T Scoreboard_NextSubgame}" Clicked="OnNextClicked" IsVisible="{Binding CanGoNext}" />
			<Button Grid.Row="1" Grid.Column="1" x:Name="FinishButton" Text="{loc:T Scoreboard_FinishGame}" Clicked="OnFinishClicked"
			        IsVisible="{Binding CanFinish}" BackgroundColor="{StaticResource PrimaryDark}" />
		</Grid>

		<!-- Manual plus / minus while typing: right above the keyboard, to go to the previous or next player's box.
		     Next (and the keyboard's own action key) first adds what's typed. -->
		<Grid Grid.Row="2" x:Name="KeyboardBar" IsVisible="False" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
			<Button x:Name="PreviousBoxButton" Text="{loc:T Scoreboard_Previous}" Clicked="OnPreviousBoxClicked"
			        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
			        BorderColor="{StaticResource Primary}" BorderWidth="1" />
			<Label Grid.Column="1" x:Name="KeyboardBarLabel" FontAttributes="Bold" FontSize="15"
			       HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
			<Button Grid.Column="2" x:Name="NextBoxButton" Text="{loc:T Scoreboard_Next}" Clicked="OnNextBoxClicked" />
		</Grid>

	</Grid>

</ContentPage>
