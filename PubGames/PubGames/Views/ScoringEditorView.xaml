<?xml version="1.0" encoding="UTF-8" ?>
<!-- A scoring type and its numbers: used for a game and again for a tie-break duel with its own scoring.
     The binding context is a ScoringEditor. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PubGames.Services"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             x:Class="PubGames.Views.ScoringEditorView"
             x:DataType="vm:ScoringEditor">

	<VerticalStackLayout Spacing="14">
		<Picker Title="{Binding ScoringTypePrompt}" ItemsSource="{Binding ScoringTypeOptions}" SelectedItem="{Binding SelectedScoringOption}" />

		<!-- Both plus / minus types: the numbers the scoreboard uses. Each limit and the warning has its own switch.
		     Plus / minus has a step; Manual plus / minus has rules for the amounts players type in. -->
		<Border IsVisible="{Binding HasScoreSettings}" BackgroundColor="{DynamicResource SurfaceMuted}"
		        StrokeThickness="0" Padding="12">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="8" />
			</Border.StrokeShape>
			<VerticalStackLayout Spacing="10">
				<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsPlusMinus}">
					<Label Text="{loc:T ScoringEditorView_StepPointsPerTap}" VerticalOptions="Center" />
					<Entry Grid.Column="1" Text="{Binding ScoreStep}" Keyboard="Numeric" HorizontalTextAlignment="End" />
				</Grid>

				<Grid ColumnDefinitions="*,100" ColumnSpacing="12">
					<Label Text="{loc:T ScoringEditorView_StartingScore}" VerticalOptions="Center" />
					<Entry Grid.Column="1" Text="{Binding StartScore}" Keyboard="Telephone" HorizontalTextAlignment="End" />
				</Grid>

				<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
					<Label Text="{loc:T ScoringEditorView_MaximumScore}" VerticalOptions="Center" />
					<Switch Grid.Column="1" IsToggled="{Binding HasMaxScore}" VerticalOptions="Center" />
					<Entry Grid.Column="2" Text="{Binding MaxScore}" Keyboard="Telephone" Placeholder="e.g. 10"
					       HorizontalTextAlignment="End" IsVisible="{Binding HasMaxScore}" />
				</Grid>

				<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
					<Label Text="{loc:T ScoringEditorView_MinimumScore}" VerticalOptions="Center" />
					<Switch Grid.Column="1" IsToggled="{Binding HasMinScore}" VerticalOptions="Center" />
					<Entry Grid.Column="2" Text="{Binding MinScore}" Keyboard="Telephone" Placeholder="e.g. 0"
					       HorizontalTextAlignment="End" IsVisible="{Binding HasMinScore}" />
				</Grid>

				<Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
					<Label Text="{loc:T ScoringEditorView_WarningAtScore}" VerticalOptions="Center" />
					<Switch Grid.Column="1" IsToggled="{Binding HasWarningScore}" VerticalOptions="Center" />
					<Entry Grid.Column="2" Text="{Binding WarningScore}" Keyboard="Telephone" Placeholder="e.g. 9"
					       HorizontalTextAlignment="End" IsVisible="{Binding HasWarningScore}" />
				</Grid>

				<!-- Manual plus / minus: rules every typed amount must meet. -->
				<VerticalStackLayout Spacing="8" IsVisible="{Binding IsManual}" Margin="0,6,0,0">
					<Label Text="{loc:T ScoringEditorView_RulesForEnteredAmounts}" FontAttributes="Bold" />
					<VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding AmountRules}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="vm:EditableScoreRule">
								<VerticalStackLayout Spacing="4">
								<Button Text="{Binding JoinerText}" Clicked="OnJoinerClicked" IsVisible="{Binding HasJoiner}"
								        HorizontalOptions="Start" HeightRequest="48" Padding="14,0" FontSize="12" FontAttributes="Bold"
								        BackgroundColor="{DynamicResource PrimaryDark}" TextColor="{DynamicResource OnPrimary}" />
								<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
									<Picker Title="{loc:T ScoringEditorView_ChooseRule}" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Text="{Binding Value}" Placeholder="{Binding ValuePlaceholder}" Keyboard="Telephone"
									       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding NeedsValue}" />
									<Entry Grid.Column="2" Text="{Binding Value2}" Placeholder="{loc:T ScoringEditorView_To}" Keyboard="Telephone"
									       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding IsBetween}" />
									<Button SemanticProperties.Description="{loc:T ScoringEditorView_RemoveRule}" Grid.Column="3" Text="✕" Clicked="OnRemoveAmountRuleClicked" WidthRequest="48" HeightRequest="48"
									        Padding="0" FontSize="14" VerticalOptions="Center"
									        BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
								</Grid>
								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
					<Label Text="{Binding AmountRulesPreview}" FontSize="12" FontAttributes="Bold" />
					<Button Text="{loc:T ScoringEditorView_AddRule}" Clicked="OnAddAmountRuleClicked" HorizontalOptions="Start"
					        HeightRequest="48" Padding="14,0" FontSize="13"
					        BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1" />
				</VerticalStackLayout>
			</VerticalStackLayout>
		</Border>

		<!-- Score sheet: lists with named rows (each with its own rules) and bonuses. Players fill it in on the scoreboard. -->
		<VerticalStackLayout IsVisible="{Binding IsSheet}" Spacing="10">
			<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Sections}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="vm:EditableSheetSection">
						<Border BackgroundColor="{DynamicResource SurfaceMuted}" StrokeThickness="0" Padding="12">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<VerticalStackLayout Spacing="8">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
									<Entry Text="{Binding Name}" Placeholder="{loc:T ScoringEditorView_ListName}" FontAttributes="Bold" />
									<Button Grid.Column="1" SemanticProperties.Description="{loc:T ScoringEditorView_RemoveList}" Text="✕" Clicked="OnRemoveSectionClicked"
										        WidthRequest="48" HeightRequest="48" Padding="0" FontSize="14" VerticalOptions="Center"
										        BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
								</Grid>

								<!-- The rows, each with a name and its own rules. -->
								<Label Text="{loc:T ScoringEditorView_Rows}" FontAttributes="Bold" FontSize="13" />
								<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="vm:EditableSheetRow">
											<Border StrokeThickness="1" Stroke="{DynamicResource Border}" Padding="8">
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="6" />
												</Border.StrokeShape>
												<VerticalStackLayout Spacing="6">
													<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
														<Entry Text="{Binding Name}" Placeholder="{loc:T ScoringEditorView_RowName}" />
														<Button Grid.Column="1" SemanticProperties.Description="{loc:T ScoringEditorView_RemoveRow}" Text="✕" Clicked="OnRemoveRowClicked"
															        WidthRequest="48" HeightRequest="48" Padding="0" FontSize="14" VerticalOptions="Center"
															        BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
													</Grid>
													<!-- A fixed score is ticked off on the scoreboard, like Full house (25); otherwise it's typed within the rules. -->
													<Grid ColumnDefinitions="Auto,*,100" ColumnSpacing="8">
														<CheckBox IsChecked="{Binding IsFixed}" VerticalOptions="Center" />
														<Label Grid.Column="1" Text="{loc:T ScoringEditorView_FixedScore}" VerticalOptions="Center" />
														<Entry Grid.Column="2" Text="{Binding FixedScore}" Keyboard="Telephone" Placeholder="e.g. 25"
														       HorizontalTextAlignment="End" IsVisible="{Binding IsFixed}" />
													</Grid>
													<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
														<CheckBox IsChecked="{Binding AllowsZero}" VerticalOptions="Center" />
														<Label Grid.Column="1" Text="{loc:T ScoringEditorView_ZeroAllowed}" VerticalOptions="Center" />
													</Grid>
													<VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Rules}" IsVisible="{Binding IsTyped}">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="vm:EditableScoreRule">
																<VerticalStackLayout Spacing="4">
																	<Button Text="{Binding JoinerText}" Clicked="OnJoinerClicked" IsVisible="{Binding HasJoiner}"
																	        HorizontalOptions="Start" HeightRequest="48" Padding="14,0" FontSize="12" FontAttributes="Bold"
																	        BackgroundColor="{DynamicResource PrimaryDark}" TextColor="{DynamicResource OnPrimary}" />
																	<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
																		<Picker Title="{loc:T ScoringEditorView_ChooseRule}" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" VerticalOptions="Center" />
																		<Entry Grid.Column="1" Text="{Binding Value}" Placeholder="{Binding ValuePlaceholder}" Keyboard="Telephone"
																		       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding NeedsValue}" />
																		<Entry Grid.Column="2" Text="{Binding Value2}" Placeholder="{loc:T ScoringEditorView_To}" Keyboard="Telephone"
																		       WidthRequest="64" HorizontalTextAlignment="End" IsVisible="{Binding IsBetween}" />
																		<Button SemanticProperties.Description="{loc:T ScoringEditorView_RemoveRule}" Grid.Column="3" Text="✕" Clicked="OnRemoveRowRuleClicked" WidthRequest="48" HeightRequest="48"
																		        Padding="0" FontSize="14" VerticalOptions="Center"
																		        BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
																	</Grid>
																</VerticalStackLayout>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>
													<Label Text="{Binding RulesPreview}" FontSize="12" />
													<Button Text="{loc:T ScoringEditorView_AddRule}" Clicked="OnAddRowRuleClicked" HorizontalOptions="Start" IsVisible="{Binding IsTyped}"
														        HeightRequest="48" Padding="14,0" FontSize="12"
														        BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1" />
												</VerticalStackLayout>
											</Border>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
								<Button Text="{loc:T ScoringEditorView_AddRow}" Clicked="OnAddRowClicked" HorizontalOptions="Start"
									        HeightRequest="48" Padding="14,0" FontSize="13"
									        BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1" />

								<!-- The bonuses: automatic at a total of the rows, or filled in per time. -->
								<Label Text="{loc:T ScoringEditorView_Bonuses}" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
								<VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Bonuses}">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="vm:EditableSheetBonus">
											<Border StrokeThickness="1" Stroke="{DynamicResource Border}" Padding="8">
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="6" />
												</Border.StrokeShape>
												<VerticalStackLayout Spacing="6">
													<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
														<Entry Text="{Binding Name}" Placeholder="{loc:T ScoringEditorView_BonusName}" />
														<Button Grid.Column="1" SemanticProperties.Description="{loc:T ScoringEditorView_RemoveBonus}" Text="✕" Clicked="OnRemoveBonusClicked"
															        WidthRequest="48" HeightRequest="48" Padding="0" FontSize="14" VerticalOptions="Center"
															        BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
													</Grid>
													<Picker ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
													<!-- Like the Yatzy bonus: only possible once the Yatzy row has a score. -->
													<Picker ItemsSource="{Binding RowChoices}" SelectedItem="{Binding RequiredRow}" />
													<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsTotalAtLeast}">
														<Label Text="{loc:T ScoringEditorView_BonusAtTotal}" VerticalOptions="Center" />
														<Entry Grid.Column="1" Text="{Binding Threshold}" Keyboard="Telephone" Placeholder="e.g. 63" HorizontalTextAlignment="End" />
													</Grid>
													<Grid ColumnDefinitions="*,100" ColumnSpacing="12">
														<Label Text="{loc:T ScoringEditorView_BonusPoints}" VerticalOptions="Center" />
														<Entry Grid.Column="1" Text="{Binding Points}" Keyboard="Telephone" Placeholder="e.g. 35" HorizontalTextAlignment="End" />
													</Grid>
													<Grid ColumnDefinitions="*,100" ColumnSpacing="12" IsVisible="{Binding IsPerTime}">
														<Label Text="{loc:T ScoringEditorView_BonusMostTimes}" VerticalOptions="Center" />
														<Entry Grid.Column="1" Text="{Binding MaxTimes}" Keyboard="Numeric" Placeholder="e.g. 2" HorizontalTextAlignment="End" />
													</Grid>
												</VerticalStackLayout>
											</Border>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
								<Button Text="{loc:T ScoringEditorView_AddBonus}" Clicked="OnAddBonusClicked" HorizontalOptions="Start"
									        HeightRequest="48" Padding="14,0" FontSize="13"
									        BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1" />
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
			<Button Text="{loc:T ScoringEditorView_AddList}" Clicked="OnAddSectionClicked" HorizontalOptions="Start"
			        HeightRequest="48" Padding="14,0" FontSize="13" />
		</VerticalStackLayout>
	</VerticalStackLayout>

</ContentView>
