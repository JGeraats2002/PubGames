<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PubGames.ViewModels"
             xmlns:models="clr-namespace:PubGames.Models"
             x:Class="PubGames.Views.StandingsPage"
             x:DataType="vm:StandingsViewModel"
             Title="{Binding PageTitle}">

	<Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

		<VerticalStackLayout Spacing="6">
			<!-- Final only: the winner(s) or loser(s), big and in words. -->
			<Border IsVisible="{Binding IsFinal}" BackgroundColor="{StaticResource ScoreLimit}" StrokeThickness="0" Padding="16,12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="10" />
				</Border.StrokeShape>
				<Label Text="{Binding Headline}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
			</Border>
			<Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
		</VerticalStackLayout>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Rows}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:PlayerStanding">
						<Border Padding="12,8" Stroke="{StaticResource Border}">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
								<!-- The place only shows on the final result. -->
								<Label Text="{Binding PlaceLabel}" FontSize="18" FontAttributes="Bold" WidthRequest="48"
								       VerticalOptions="Center" IsVisible="{Binding ShowPlace}" />
								<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
									<Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
									<Label Text="{Binding Total}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
								</VerticalStackLayout>
							</Grid>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</ScrollView>

		<Button Grid.Row="2" Text="{Binding DoneText}" Clicked="OnDoneClicked" />

	</Grid>

</ContentPage>
