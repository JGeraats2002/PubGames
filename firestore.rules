rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules > Publish.
// These rules are what actually protect the cloud data; the app's own checks
// are just UI. Keep the built-in admin list in sync with AuthConfig.AdminEmails.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Always admin, can't be removed from inside the app.
    function isBuiltInAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['jjh.geraats@gmail.com'];
    }

    function memberPath() {
      return /databases/$(database)/documents/team/$(myEmail());
    }

    // Admins and moderators added on the Team page (team/{lower-case email}).
    function isTeamMember() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath());
    }

    function member() {
      return get(memberPath()).data;
    }

    function isAdmin() {
      return isBuiltInAdmin() || (isTeamMember() && member().role == 'Admin');
    }

    function canAddGames() {
      return isAdmin() || (isTeamMember() && member().canAddGames == true);
    }

    function canDeleteGames() {
      return isAdmin() || (isTeamMember() && member().canDeleteGames == true);
    }

    match /games/{gameId} {
      // Every signed-in user sees published games; admins and moderators also see drafts, pending and deleted ones.
      allow read: if isSignedIn() && (resource.data.status == 'Published' || isAdmin() || isTeamMember());

      // The id field must match the document.
      // - Publish rights: create, edit and publish; marking Deleted also needs delete rights.
      // - Without publish rights: only new/draft/pending games, and only as "waiting for approval".
      allow create, update: if request.resource.data.id == gameId && (
        (canAddGames() && (request.resource.data.status != 'Deleted' || canDeleteGames()))
        || (isTeamMember()
            && request.resource.data.status == 'PendingPublishApproval'
            && (resource == null || resource.data.status in ['Draft', 'PendingPublishApproval']))
      );
    }

    // Publish/delete requests from moderators without the matching permission.
    match /approvals/{requestId} {
      allow read: if isAdmin() || (isTeamMember() && resource.data.requestedByEmail == myEmail());
      allow create: if isTeamMember()
        && request.resource.data.id == requestId
        && request.resource.data.requestedByEmail == myEmail()
        && request.resource.data.status == 'Pending';
      allow update: if isAdmin();
    }

    // Team members, one document per lower-case email. Everyone can read their own
    // (that's how the app knows you're a moderator); only admins manage the team.
    match /team/{email} {
      allow read: if isAdmin() || (isSignedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    // Outgoing emails for Firebase's Trigger Email extension (only used once
    // the app switches to FirestoreEmailSender).
    match /mail/{mailId} {
      allow create: if isAdmin();
    }

    // Game images (covers and rules pictures) while on the free plan - see FirestoreImageStore.
    match /images/{imageId} {
      allow read: if isSignedIn();
      // Size cap keeps each image well under Firestore's 1 MiB document limit.
      allow create, update: if (isAdmin() || isTeamMember())
        && request.resource.data.id == imageId
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 700 * 1024;
      allow delete: if isAdmin();
    }

    // Everything else is locked until it gets its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
