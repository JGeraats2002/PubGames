rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules > Publish.
// These rules are what actually protect the cloud data; the app's own checks
// are just UI. Keep the built-in admin list in sync with AuthConfig.AdminEmails.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function builtInAdminEmails() {
      return ['jjh.geraats@gmail.com'];
    }

    // Always admin, can't be removed from inside the app.
    function isBuiltInAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in builtInAdminEmails();
    }

    function memberPath() {
      return /databases/$(database)/documents/team/$(myEmail());
    }

    // Admins and moderators added on the Team page (team/{lower-case email}).
    function isTeamMember() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath());
    }

    function member() {
      return get(memberPath()).data;
    }

    function isAdmin() {
      return isBuiltInAdmin() || (isTeamMember() && member().role == 'Admin');
    }

    // Anyone who works on the library: admins (built-in or added) and moderators.
    function isOnTeam() {
      return isAdmin() || isTeamMember();
    }

    match /games/{gameId} {
      // Every signed-in user sees published games; the team also sees drafts and deleted ones.
      allow read: if isSignedIn() && (resource.data.status == 'Published' || isOnTeam());

      // Only admins change games (directly, or by approving a moderator's review request).
      // The id field must match the document.
      allow create, update: if isAdmin() && request.resource.data.id == gameId;
    }

    // Game categories. Everyone reads them (players filter by category); only admins
    // add them (directly, or by approving a moderator's New category request).
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.id == categoryId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }

    // Main categories (Play style, Duration, ...) that categories are filed under
    // (categories/{id}.groupId). Same rights as categories.
    match /categoryGroups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.id == groupId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }

    // Things for an admin to review: moderators' proposals (new game, changes to a game,
    // deletion, new category, new main category) and the automatic "add games to category" requests.
    match /reviewRequests/{requestId} {
      function isMine(data) {
        return isOnTeam() && data.submittedByEmail == myEmail();
      }

      // Admins see all; moderators see their own, including the admin's decision. Moderators
      // also see what's still waiting from the others, so two of them don't change the same
      // game at once (the app shows who has changes waiting and keeps the others out until then).
      allow read: if isAdmin() || isMine(resource.data)
        || (isOnTeam() && resource.data.status == 'WaitingForReview');

      // Submitted in your own name, always as waiting for review. Only admins
      // create "add games to category" requests (the app does, when a category is added).
      allow create: if request.resource.data.id == requestId
        && isMine(request.resource.data)
        && request.resource.data.status == 'WaitingForReview'
        && (request.resource.data.type != 'AddGamesToCategory' || isAdmin());

      // Admins record their decision. Moderators may replace their own request while it's still
      // waiting (or resubmit it after a rejection), but can never mark it approved.
      allow update: if isAdmin()
        || (isMine(resource.data)
            && isMine(request.resource.data)
            && resource.data.status != 'Approved'
            && request.resource.data.status == 'WaitingForReview');

      // Moderators withdraw their own request while it's still waiting.
      allow delete: if isAdmin()
        || (isMine(resource.data) && resource.data.status == 'WaitingForReview');
    }

    // Short messages between admins and moderators (the Inbox), including review decisions.
    // toEmail is a team member's lower-case email, or 'admins' for one message shared by all admins.
    match /messages/{messageId} {
      function isRecipient(data) {
        return data.toEmail == myEmail() || (data.toEmail == 'admins' && isAdmin());
      }

      function isValidRecipient(to) {
        return to == 'admins'
          || to in builtInAdminEmails()
          || exists(/databases/$(database)/documents/team/$(to));
      }

      allow read: if isOnTeam() && isRecipient(resource.data);

      // Sent in your own name, to someone on the team, and short.
      allow create: if isOnTeam()
        && request.resource.data.id == messageId
        && request.resource.data.fromEmail == myEmail()
        && isValidRecipient(request.resource.data.toEmail)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.isRead == false
        // Only admins send review decisions.
        && (request.resource.data.kind == 'Message' || isAdmin());

      // The recipient can only mark it read.
      allow update: if isOnTeam()
        && isRecipient(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      // The recipient decides whether to keep or delete it.
      allow delete: if isOnTeam() && isRecipient(resource.data);
    }

    // Team members, one document per lower-case email. Everyone can read their own
    // (that's how the app knows you're a moderator); the team reads all of them, to pick
    // who to message. Admins add and remove moderators; only the owner (a built-in admin)
    // makes someone admin, turns an admin back into a moderator or removes an admin.
    match /team/{email} {
      allow read: if isOnTeam() || (isSignedIn() && email == myEmail());
      allow create: if isBuiltInAdmin()
        || (isAdmin() && request.resource.data.role == 'Moderator');
      // Members may change their own name on the list (from their profile), and nothing else.
      allow update: if isBuiltInAdmin()
        || (isAdmin() && resource.data.role == 'Moderator' && request.resource.data.role == 'Moderator')
        || (isSignedIn() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 40);
      allow delete: if isBuiltInAdmin()
        || (isAdmin() && resource.data.role == 'Moderator');
    }

    // Player profiles: what others see when they add you by your personal code.
    // Everyone signed in can read them; you only write your own, with the code you claimed.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
    }

    // Personal codes, claimed once: a code that exists can't be taken again, which keeps them unique.
    match /codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == code
        && code.size() == 8;
    }

    // Profile pictures; only the person themselves adds or removes theirs.
    match /profilePhotos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == photoId
        && photoId.matches(request.auth.uid + '_[A-Za-z0-9]+')
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 200 * 1024;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // One document per finished game with each linked player's outcome: their stats.
    // Written by the phone the game was played on; read by the players who were in it.
    match /gameResults/{resultId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn()
        && request.resource.data.id == resultId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() <= 40;
      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() <= 40;
    }

    // Outgoing emails for Firebase's Trigger Email extension (only used once
    // the app switches to FirestoreEmailSender).
    match /mail/{mailId} {
      allow create: if isAdmin();
    }

    // Game images (covers and rules pictures) while on the free plan - see FirestoreImageStore.
    match /images/{imageId} {
      allow read: if isSignedIn();
      // Size cap keeps each image well under Firestore's 1 MiB document limit.
      allow create, update: if isOnTeam()
        && request.resource.data.id == imageId
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 700 * 1024;
      allow delete: if isAdmin();
    }

    // Everything else is locked until it gets its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
