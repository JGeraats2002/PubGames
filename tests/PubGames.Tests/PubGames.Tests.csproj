<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tests for the app's logic that doesn't need a phone. The app's own files are linked in (not
	     copied); Stubs.cs stands in for the few phone-only parts they use. Run with: dotnet test -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>PubGames.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="PubGames.Services.L" Alias="L" />
	</ItemGroup>

	<!-- The app's files under test. -->
	<ItemGroup>
		<Compile Include="..\..\PubGames\PubGames\Models\GameTranslation.cs" Link="App\GameTranslation.cs" />
		<Compile Include="..\..\PubGames\PubGames\Models\DrawKind.cs" Link="App\DrawKind.cs" />
		<Compile Include="..\..\PubGames\PubGames\Models\CategoryGroup.cs" Link="App\CategoryGroup.cs" />
		<Compile Include="..\..\PubGames\PubGames\Models\GameCategory.cs" Link="App\GameCategory.cs" />
		<Compile Include="..\..\PubGames\PubGames\Models\RulesBlock.cs" Link="App\RulesBlock.cs" />
		<Compile Include="..\..\PubGames\PubGames\Services\TranslatedPictures.cs" Link="App\TranslatedPictures.cs" />
		<Compile Include="..\..\PubGames\PubGames\Models\Sentences.cs" Link="App\Sentences.cs" />
	</ItemGroup>

	<!-- The examples the Cloud Functions are tested with too (functions/test). -->
	<ItemGroup>
		<None Include="..\shared-cases.json" Link="shared-cases.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
